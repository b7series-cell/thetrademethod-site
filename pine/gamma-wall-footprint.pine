//@version=6
indicator("Gamma Wall Footprint [TTM]", shorttitle = "GW Footprint", overlay = true, max_lines_count = 300, max_labels_count = 300)

// ════════════════════════════════════════════════════════════════════════════
// The Trade Method · thetrademethod.com/setups/gamma-wall-footprint.html
// Three GEX setups the footprint confirms, on a 5-minute NQ chart:
//   1. Put wall long   2. Call wall short   3. Zero gamma break short
// A slow drift into a wall: absorption at the wall, then stacked imbalances
// and a delta flip. A fast push: let it overshoot, then the reclaim with the
// trapped traders. Stop past the failed reaction (at least 30 ticks), target
// the next level, half off halfway there. Below zero gamma and holding: short
// with it, 30-point stop, target the put wall.
//
// HOW TO USE
// 1) Each morning type today's put wall, call wall and zero gamma (from your
//    GEX source, in the chart's prices).
// 2) Optional: paste older days into "Levels by date" to see past signals:
//        2026-11-24,PW=25150,CW=25450,GF=25250
// 3) Needs TradingView's footprint data (request.footprint, Premium plans and
//    up). Without it only the zero gamma break can fire.
// Everything mechanical below the page's own words (zone size, how fast is
// "fast", windows in bars) is our reading of the rules, not the video's.
// ════════════════════════════════════════════════════════════════════════════

// ── Inputs: today's map ─────────────────────────────────────────────────────
string G_MAP = "Today's GEX map"
float inPW = input.float(0.0, "Put wall", step = 0.25, group = G_MAP, tooltip = "0 = off")
float inCW = input.float(0.0, "Call wall", step = 0.25, group = G_MAP, tooltip = "0 = off")
float inGF = input.float(0.0, "Zero gamma", step = 0.25, group = G_MAP, tooltip = "0 = off")
string histTxt = input.text_area("", "Levels by date (optional)", group = G_MAP, tooltip = "One line per day: YYYY-MM-DD,PW=..,CW=..,GF=..  Days with a line use it. Today uses the inputs above unless it has its own line.")
bool allDays = input.bool(false, "Use today's levels on every day", group = G_MAP, tooltip = "Off: signals only on today and on days listed above.")

// ── Inputs: rules ───────────────────────────────────────────────────────────
string G_RU = "Rules"
string confirmMode = input.string("Entry rules (all signs)", "Footprint confirmation", options = ["Entry rules (all signs)", "Any one sign"], group = G_RU, tooltip = "Entry rules: slow = absorption, then stacked imbalances + delta flip; fast = overshoot with trapped buyers/sellers, then reclaim + stack + flip. Any one sign: absorption, a delta flip or stacked imbalances at the wall; on a fast push the reclaim itself.")
int ticksPerRow = input.int(20, "Footprint row size (ticks)", minval = 1, group = G_RU, tooltip = "20 ticks = 5 NQ points, the rows in the video.")
int imbPct = input.int(300, "Imbalance (%)", minval = 100, group = G_RU, tooltip = "300 = buyers 3x the sellers one row below (and the mirror).")
int stackRows = input.int(3, "Stacked rows", minval = 2, group = G_RU)
float zonePts = input.float(5.0, "Wall zone (points)", step = 0.25, group = G_RU)
float fastAtr = input.float(1.5, "Fast approach: move over 3 bars (x ATR)", step = 0.1, group = G_RU)
int minStopTicks = input.int(30, "Minimum stop (ticks)", minval = 1, group = G_RU)
float breakStop = input.float(30.0, "Zero gamma break stop (points)", step = 0.25, group = G_RU)
int maxTrades = input.int(2, "Max trades a day", minval = 1, group = G_RU)
bool skipExp = input.bool(true, "Skip OPEX and VIX expiration days", group = G_RU)
string winSess = input.session("0930-1130", "Entry window (ET)", group = G_RU)

// ── Inputs: display ─────────────────────────────────────────────────────────
string G_DS = "Display"
color cPW = input.color(#22c55e, "Put wall", group = G_DS)
color cCW = input.color(#ef4444, "Call wall", group = G_DS)
color cGF = input.color(#eab308, "Zero gamma", group = G_DS)
bool showTbl = input.bool(true, "Status table", group = G_DS)

// ── Constants ───────────────────────────────────────────────────────────────
string TZ = "America/New_York"
float TICK = syminfo.mintick
bool ANY = confirmMode == "Any one sign"
int ATR_LEN = 14
int DELTA_LEN = 20

// ── Footprint (one request per script) ──────────────────────────────────────
footprint fp = request.footprint(ticksPerRow, 70, imbPct)
bool hasFp = not na(fp)
float fpDelta = hasFp ? fp.delta() : na
float rowSize = ticksPerRow * TICK

// Stacked imbalances: 3+ rows in a row where buyers >= imb% of the sellers one
// row below (side +1), or sellers >= imb% of the buyers one row above (side -1).
f_stacked(footprint f, int side) =>
    bool res = false
    if not na(f)
        array<volume_row> rows = f.rows()
        map<int, float> buys = map.new<int, float>()
        map<int, float> sells = map.new<int, float>()
        for r in rows
            int k = int(math.round(r.down_price() / rowSize))
            buys.put(k, r.buy_volume())
            sells.put(k, r.sell_volume())
        array<int> hits = array.new<int>()
        for k in buys.keys()
            float b = buys.get(k)
            float s = sells.get(k)
            if side > 0
                float below = sells.contains(k - 1) ? sells.get(k - 1) : 0.0
                if b > 0 and b * 100 >= imbPct * below and (below > 0 or b >= 10)
                    hits.push(k)
            else
                float above = buys.contains(k + 1) ? buys.get(k + 1) : 0.0
                if s > 0 and s * 100 >= imbPct * above and (above > 0 or s >= 10)
                    hits.push(k)
        int best = 0
        if hits.size() > 0
            hits.sort()
            int run = 0
            for i = 0 to hits.size() - 1
                run := i > 0 and hits.get(i) == hits.get(i - 1) + 1 ? run + 1 : 1
                best := math.max(best, run)
        res := best >= stackRows
    res

// ── Calendar: monthly OPEX (3rd Friday) and VIX expiration ─────────────────
f_thirdFri(int y, int m) =>
    int t15 = timestamp(TZ, y, m, 15, 12, 0)
    int dow = dayofweek(t15, TZ)                     // 1 = Sunday ... 6 = Friday
    15 + (6 - dow + 7) % 7

f_isSkip(int t) =>
    int y = year(t, TZ)
    int m = month(t, TZ)
    int d = dayofmonth(t, TZ)
    bool opex = d == f_thirdFri(y, m)
    int ny = m == 12 ? y + 1 : y
    int nm = m == 12 ? 1 : m + 1
    int vixT = timestamp(TZ, ny, nm, f_thirdFri(ny, nm), 12, 0) - 30 * 86400000
    bool vix = year(vixT, TZ) == y and month(vixT, TZ) == m and dayofmonth(vixT, TZ) == d
    opex or vix

// ── Levels by date ──────────────────────────────────────────────────────────
var map<int, float> hPW = map.new<int, float>()
var map<int, float> hCW = map.new<int, float>()
var map<int, float> hGF = map.new<int, float>()
if barstate.isfirst and str.length(histTxt) > 0
    for ln in str.split(histTxt, "\n")
        array<string> parts = str.split(str.trim(ln), ",")
        if parts.size() >= 2
            array<string> ymd = str.split(parts.get(0), "-")
            if ymd.size() == 3
                int key = int(str.tonumber(ymd.get(0))) * 10000 + int(str.tonumber(ymd.get(1))) * 100 + int(str.tonumber(ymd.get(2)))
                for i = 1 to parts.size() - 1
                    array<string> kv = str.split(str.trim(parts.get(i)), "=")
                    if kv.size() == 2
                        float v = str.tonumber(kv.get(1))
                        string k = str.upper(kv.get(0))
                        if k == "PW"
                            hPW.put(key, v)
                        else if k == "CW"
                            hCW.put(key, v)
                        else if k == "GF" or k == "ZG"
                            hGF.put(key, v)

// ── Session state ───────────────────────────────────────────────────────────
bool rth = not na(time(timeframe.period, "0930-1600", TZ))
bool inWin = not na(time(timeframe.period, winSess, TZ))
bool fpWin = not na(time(timeframe.period, "0930-1200", TZ))
int etMin = hour(time, TZ) * 60 + minute(time, TZ)
int dayKey = year(time, TZ) * 10000 + month(time, TZ) * 100 + dayofmonth(time, TZ)
int todayKey = year(timenow, TZ) * 10000 + month(timenow, TZ) * 100 + dayofmonth(timenow, TZ)
bool newDay = rth and (bar_index == 0 or not rth[1] or dayKey != dayKey[1])

var float PW = na
var float CW = na
var float GF = na
var bool tradeDay = false
var array<float> trs = array.new<float>()
var array<float> absd = array.new<float>()
var array<float> dCl = array.new<float>()          // today's RTH closes
var array<float> dRg = array.new<float>()          // today's RTH ranges
var float prevC = na
var bool aboveGF = false
var int taken = 0

// per wall: 0 = put wall (side +1), 1 = call wall (side -1)
var array<bool> armed = array.from(false, false)
var array<string> kind = array.from("", "")
var array<int> kk = array.from(0, 0)
var array<float> pExt = array.from(0.0, 0.0)
var array<float> pAvg = array.from(0.0, 0.0)
var array<float> pD0 = array.from(0.0, 0.0)
var array<bool> pFast = array.from(false, false)

// open trade
var bool inPos = false
var int tSide = 0
var float tEntry = na
var float tStop = na
var float tTgt = na
var float tHalf = na
var bool tGot = false
var bool tHalfOn = true
var float tWall = na
var float tGfExit = na
var string lastMsg = "Waiting for a touch"

f_lvl(map<int, float> h, int key, float today) =>
    h.contains(key) ? h.get(key) : (key == todayKey or allDays) and today > 0 ? today : na

if newDay
    PW := f_lvl(hPW, dayKey, inPW)
    CW := f_lvl(hCW, dayKey, inCW)
    GF := f_lvl(hGF, dayKey, inGF)
    tradeDay := not (skipExp and f_isSkip(time))
    dCl.clear()
    dRg.clear()
    aboveGF := false
    taken := 0
    armed.fill(false)
    kind.fill("")
    if not na(PW)
        line.new(bar_index, PW, bar_index + 78, PW, color = cPW, width = 2)
        label.new(bar_index, PW, "Put wall " + str.tostring(PW), style = label.style_label_right, color = color.new(cPW, 80), textcolor = cPW, size = size.small)
    if not na(CW)
        line.new(bar_index, CW, bar_index + 78, CW, color = cCW, width = 2)
        label.new(bar_index, CW, "Call wall " + str.tostring(CW), style = label.style_label_right, color = color.new(cCW, 80), textcolor = cCW, size = size.small)
    if not na(GF)
        line.new(bar_index, GF, bar_index + 78, GF, color = cGF, width = 1, style = line.style_dashed)
        label.new(bar_index, GF, "Zero gamma " + str.tostring(GF), style = label.style_label_right, color = color.new(cGF, 80), textcolor = cGF, size = size.small)

bool longSig = false
bool shortSig = false
bool exitedNow = false

if rth
    // ATR and average |delta| from RTH bars only (the test uses the same)
    float pc = na(prevC) ? open : prevC
    trs.push(math.max(high - low, math.abs(high - pc), math.abs(low - pc)))
    if trs.size() > ATR_LEN
        trs.shift()
    prevC := close
    float atr = trs.avg()
    float avgd = absd.size() > 0 ? absd.avg() : na
    bool fpOk = hasFp and fpWin and not na(fpDelta)
    if fpOk
        absd.push(math.abs(fpDelta))
        if absd.size() > DELTA_LEN
            absd.shift()
    int i = dCl.size()
    dCl.push(close)
    dRg.push(high - low)
    if not na(GF) and close > GF
        aboveGF := true

    // ── manage the open trade (bars after the entry bar)
    if inPos
        float risk = math.abs(tEntry - tStop)
        float exitPx = na
        string how = ""
        bool hitStop = tSide > 0 ? low <= tStop : high >= tStop
        if hitStop
            exitPx := tStop
            how := tGot ? "stop after half" : "stop"
        else
            if tHalfOn and not tGot and (tSide > 0 ? high >= tHalf : low <= tHalf)
                tGot := true
                label.new(bar_index, tHalf, "½", style = label.style_label_center, color = color.new(color.gray, 70), textcolor = color.white, size = size.tiny)
            if tSide > 0 ? high >= tTgt : low <= tTgt
                exitPx := tTgt
                how := "target"
            else if not na(tWall) and tSide * (close - tWall) < -zonePts
                exitPx := close
                how := "closed through the wall"
            else if not na(tGfExit) and close > tGfExit
                exitPx := close
                how := "back above zero gamma"
            else if etMin >= 955
                exitPx := close
                how := "flat 15:55"
        if not na(exitPx)
            float runR = tSide * (exitPx - tEntry) / risk
            float R = tGot ? 0.5 * tSide * (tHalf - tEntry) / risk + 0.5 * runR : runR
            label.new(bar_index, exitPx, how + " " + str.tostring(R, "+0.00;-0.00") + "R", style = tSide > 0 ? label.style_label_down : label.style_label_up, color = color.new(R > 0 ? color.teal : color.maroon, 20), textcolor = color.white, size = size.tiny)
            inPos := false
            exitedNow := true
            lastMsg := "Last trade: " + how + " " + str.tostring(R, "+0.00;-0.00") + "R"

    bool free = tradeDay and not inPos and not exitedNow and taken < maxTrades
    bool canEnter = inWin and free
    int sig = 0                                      // +1 long, -1 short
    float sEntry = na
    float sStop = na
    float sTgt = na
    float sWall = na
    float sGf = na
    bool sHalfOn = true
    string sName = ""

    // ── setup 3: zero gamma break short
    if canEnter and not na(GF) and not na(PW) and aboveGF and i >= 4
        if dCl.get(i - 1) < GF - zonePts and close < GF and not (dCl.get(i - 2) < GF - zonePts)
            float r3 = (dRg.get(i) + dRg.get(i - 1) + dRg.get(i - 2)) / 3
            float sum12 = 0.0
            int n12 = 0
            for k = math.max(0, i - 14) to i - 3
                sum12 += dRg.get(k)
                n12 += 1
            float r12 = sum12 / n12
            if r3 > r12 and close - PW >= breakStop
                sig := -1
                sEntry := close
                sStop := close + breakStop
                sTgt := PW
                sGf := GF
                sHalfOn := false
                sName := "Zero gamma break short"

    // ── setups 1/2: wall fades
    for w = 0 to 1
        float lvl = w == 0 ? PW : CW
        int s = w == 0 ? 1 : -1
        if na(lvl)
            continue
        float near = s > 0 ? low : high
        if not free
            kind.set(w, "")
        if kind.get(w) == "" and canEnter and armed.get(w) and s * (near - lvl) <= zonePts
            armed.set(w, false)
            if fpOk and not na(avgd)
                bool fast = i >= 3 and s * (dCl.get(i - 3) - near) >= fastAtr * atr
                kind.set(w, ANY ? (fast ? "fast_any" : "slow_any") : (fast ? "fast_o" : "slow_a"))
                kk.set(w, 0)
                pExt.set(w, near)
                pAvg.set(w, avgd)
                pD0.set(w, fpDelta)
                pFast.set(w, fast)
        else
            armed.set(w, s * (close - lvl) > zonePts)
        string kd = kind.get(w)
        if kd == "" or sig != 0
            continue
        float ext = pExt.get(w)
        bool extNew = s > 0 ? low < ext : high > ext
        float extUpd = s > 0 ? math.min(ext, low) : math.max(ext, high)
        bool closedThrough = s * (close - lvl) < -zonePts
        float d = fpDelta
        int k = kk.get(w)
        bool fire = false
        bool kill = false
        if kd == "slow_a"
            if not fpOk or closedThrough
                kill := true
            else
                pExt.set(w, extUpd)
                if -s * d >= pAvg.get(w)
                    kind.set(w, "slow_c")
                    k := -1
                else if k >= 1
                    kill := true
        else if kd == "slow_c"
            if not fpOk or closedThrough
                kill := true
            else if not extNew and s * d > 0 and f_stacked(fp, s)
                fire := true
            else
                pExt.set(w, extUpd)
                if k >= 1
                    kill := true
        else if kd == "fast_o"
            pExt.set(w, extUpd)
            bool through = s > 0 ? low < lvl : high > lvl
            if through and fpOk and -s * d > 0
                kind.set(w, "fast_r")
                k := -1
            else if k >= 2
                kill := true
        else if kd == "fast_r"
            if not fpOk
                kill := true
            else
                pExt.set(w, extUpd)
                if s * (close - lvl) > 0 and s * d > 0 and f_stacked(fp, s)
                    fire := true
                else if k >= 3
                    kill := true
        else if kd == "slow_any"
            if not fpOk or closedThrough
                kill := true
            else
                pExt.set(w, extUpd)
                bool absorb = -s * d >= pAvg.get(w) and s * (close - lvl) >= 0
                bool flip = k > 0 and -s * pD0.get(w) > 0 and s * d > 0
                if absorb or flip or f_stacked(fp, s)
                    fire := true
                else if k >= 2
                    kill := true
        else if kd == "fast_any"
            pExt.set(w, extUpd)
            if k > 0 and s * (extUpd - lvl) < 0 and s * (close - lvl) > 0
                fire := true
            else if k >= 4
                kill := true
        kk.set(w, k + 1)
        if fire
            kind.set(w, "")
            if inWin
                float stp = pExt.get(w) - s * TICK
                if math.abs(close - stp) < minStopTicks * TICK
                    stp := close - s * minStopTicks * TICK
                float rk = math.abs(close - stp)
                // next level in the trade's direction
                float tgt = na
                for lv in array.from(PW, CW, GF)
                    if not na(lv) and s * (lv - close) > 0
                        tgt := na(tgt) or math.abs(lv - close) < math.abs(tgt - close) ? lv : tgt
                if not na(tgt) and math.abs(tgt - close) >= rk
                    sig := s
                    sEntry := close
                    sStop := stp
                    sTgt := tgt
                    sWall := lvl
                    sHalfOn := true
                    sName := (s > 0 ? "Put wall long" : "Call wall short") + (pFast.get(w) ? " (fast)" : " (slow)")
                else
                    lastMsg := "Skipped: next level under 1R"
        else if kill
            kind.set(w, "")

    if sig != 0
        inPos := true
        tSide := sig
        tEntry := sEntry
        tStop := sStop
        tTgt := sTgt
        tHalf := sEntry + sig * math.abs(sTgt - sEntry) / 2
        tGot := false
        tHalfOn := sHalfOn
        tWall := sWall
        tGfExit := sGf
        taken += 1
        armed.fill(false)
        kind.fill("")
        longSig := sig > 0
        shortSig := sig < 0
        float rr = math.abs(sTgt - sEntry) / math.abs(sEntry - sStop)
        label.new(bar_index, sEntry, sName + "\n" + str.tostring(sEntry) + "  stop " + str.tostring(sStop) + "\ntarget " + str.tostring(sTgt) + " (" + str.tostring(rr, "0.0") + "R)", style = sig > 0 ? label.style_label_up : label.style_label_down, yloc = sig > 0 ? yloc.belowbar : yloc.abovebar, color = sig > 0 ? color.new(cPW, 10) : color.new(cCW, 10), textcolor = color.white, size = size.small)
        line.new(bar_index, sStop, bar_index + 12, sStop, color = color.red, style = line.style_dotted)
        line.new(bar_index, sTgt, bar_index + 12, sTgt, color = color.teal, style = line.style_dotted)
        if sHalfOn
            line.new(bar_index, tHalf, bar_index + 12, tHalf, color = color.gray, style = line.style_dotted)
        lastMsg := sName + " at " + str.tostring(sEntry)

alertcondition(longSig, "Gamma wall long", "Gamma Wall Footprint: put wall long")
alertcondition(shortSig, "Gamma wall short", "Gamma Wall Footprint: short (call wall or zero gamma break)")

// ── Status table ────────────────────────────────────────────────────────────
var table tb = table.new(position.top_right, 2, 5, bgcolor = color.new(#0b1220, 10), border_width = 1)
if showTbl and barstate.islast
    string regime = na(GF) ? "no zero gamma" : close > GF ? "above zero gamma (the lake)" : "below zero gamma (the rapids)"
    table.cell(tb, 0, 0, "Gamma Wall Footprint", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, timeframe.period == "5" ? "5-min" : "built for 5-min", text_color = timeframe.period == "5" ? color.gray : color.orange, text_size = size.small)
    table.cell(tb, 0, 1, "Regime", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 1, regime, text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Footprint", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 2, hasFp ? "on" : "not available (Premium)", text_color = hasFp ? color.teal : color.orange, text_size = size.small)
    table.cell(tb, 0, 3, "Today", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 3, not tradeDay ? "OPEX / VIX day: skip" : str.tostring(taken) + " of " + str.tostring(maxTrades) + " trades", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 4, "Last", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 4, lastMsg, text_color = color.white, text_size = size.small)
