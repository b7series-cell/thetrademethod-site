//@version=6
// =====================================================================
// Anchored VWAP (earnings and catalysts) — thetrademethod.com
//
// From an SMB Capital lesson on anchoring VWAP to the event that started
// the move. Works on any time frame; a 15-minute chart with extended
// hours on shows the after-hours reaction, the daily chart runs the trail.
//
//   1. Anchor     Click the bar where the news hit (the earnings release,
//                 or the bar where a catalyst like an election-night rally
//                 began). The VWAP runs from that bar on.
//   2. Source     Low of each bar by default, the video's tweak for strong
//                 stocks in an uptrend (it sits about half an intraday ATR
//                 under the normal VWAP). The normal VWAP can be shown too.
//   3. The report After-hours volume from the anchor to the next 9:30 open,
//                 as a share of the 20-day average daily volume. The video
//                 wants 20% at least; 50 to 70% is better.
//   4. The read   Above the line: buyers in control since the news.
//   5. Entry      Day one or day two after the anchor: a bar in the first
//      (marked)   N minutes dips to within a set distance of the line and
//                 closes back above the day's open (the dip and reclaim).
//                 Stop a set buffer under the line.
//   6. Trail      A DAILY close below the line: cut at least half. A later
//                 daily close back above it: back on the table.
//
// The anchor, the low source, the 20% / 50-70% volume grades and the
// cut-half rule are from the video. The "near the line" distance, the
// opening window, the stop buffer and the 20-day average are ours.
// Draws and alerts only; it places no orders.
// =====================================================================
indicator("Anchored VWAP (Earnings and Catalysts)", shorttitle = "AVWAP Catalyst", overlay = true, max_labels_count = 200, max_lines_count = 50)

// ---------------- inputs ----------------
anchorT  = input.time(timestamp("2024-10-30T16:00:00-04:00"), "Anchor bar (click the release candle)", confirm = true, group = "Anchor")
useLow   = input.bool(true, "Source: low of each bar (for strong stocks)", group = "Lines")
showNorm = input.bool(true, "Also draw the normal VWAP (typical price)", group = "Lines")
tz       = "America/New_York"
rth      = input.session("0930-1600", "Regular session (New York)", group = "Session")
advLen   = input.int(20, "Average daily volume length (days)", minval = 1, group = "The report")
nearAtr  = input.float(0.5, "Dip counts if within × ATR(14) of the line", minval = 0.0, step = 0.05, group = "Entry (ours)")
winMin   = input.int(30, "Opening window for the dip and reclaim (minutes)", minval = 1, group = "Entry (ours)")
bufAtr   = input.float(0.1, "Stop buffer under the line (× ATR 14)", minval = 0.0, step = 0.05, group = "Entry (ours)")
riskUsd  = input.float(500.0, "Risk per trade ($) for share size", minval = 0.0, group = "Entry (ours)")
showPanel = input.bool(true, "Show status panel", group = "Display")

// ---------------- anchored VWAPs ----------------
started = time >= anchorT
var float sv   = 0.0
var float spvL = 0.0
var float spvN = 0.0
if started
    sv   += volume
    spvL += low * volume
    spvN += hlc3 * volume
avLow  = started and sv > 0 ? spvL / sv : na
avNorm = started and sv > 0 ? spvN / sv : na
av     = useLow ? avLow : avNorm

plot(av, "Anchored VWAP", color = #5ac8fa, linewidth = 2)
plot(showNorm and useLow ? avNorm : na, "Normal VWAP", color = color.new(#8e8e93, 30), linewidth = 1, style = plot.style_circles)
plotshape(started and not started[1], "Anchor", shape.circle, location.belowbar, color.new(#bf5af2, 0), size = size.small, text = "anchor", textcolor = #bf5af2)

// ---------------- session and daily facts ----------------
intraday  = timeframe.isintraday
inRth     = not na(time(timeframe.period, rth, tz))
newDay    = dayofmonth(time, tz) != dayofmonth(time[1], tz)
rthOpenBar = inRth and (not inRth[1] or newDay)
var float dayOpen = na
if rthOpenBar
    dayOpen := open
minsIn = (time - timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), 9, 30)) / 60000
nextT  = time + timeframe.in_seconds() * 1000
endMs  = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), 16, 0)
lastRth = intraday ? inRth and nextT >= endMs : true   // on a daily chart every bar is a daily close
advD   = request.security(syminfo.tickerid, "D", ta.sma(volume, advLen)[1], lookahead = barmerge.lookahead_on)
atr14  = ta.atr(14)
isAnchor = started and not started[1]
var int anchorBar = na
if isAnchor
    anchorBar := bar_index

// ---------------- the report: after-hours volume share ----------------
var float ahVol = 0.0
var int   ahBars = 0
var bool  ahDone = false
var label ahLab = na
if started and intraday and not ahDone
    if rthOpenBar and not isAnchor
        ahDone := true
        pct = advD > 0 and ahBars > 0 ? ahVol / advD * 100 : na
        grade = na(pct) ? "" : pct >= 50 ? "strong" : pct >= 20 ? "ok" : "thin"
        txt = na(pct) ? "Turn on extended hours to grade the report's after-hours volume" : "After hours: " + str.tostring(pct, "0") + "% of avg day (" + grade + ")\n20% minimum · 50-70% better"
        ahLab := label.new(bar_index, high, txt,
             style = label.style_label_down, color = color.new(na(pct) ? #636366 : pct >= 50 ? #30d158 : pct >= 20 ? #2997ff : #ff453a, 15), textcolor = color.white, size = size.small)
    else
        ahVol += volume
        if not inRth
            ahBars += 1

// ---------------- count sessions since the anchor ----------------
var int dayN = 0      // 1 = day one, 2 = day two
if started and rthOpenBar
    dayN += 1

// ---------------- entry: the dip and reclaim, day one or two ----------------
var bool tookDay = false
var bool dipped  = false
if rthOpenBar
    tookDay := false
    dipped  := false
evEntry = false
float ePx = na
float sPx = na
if intraday and started and bar_index > anchorBar and inRth and (dayN == 1 or dayN == 2) and minsIn < winMin and not tookDay and not na(av)
    dipNear = low <= av + nearAtr * atr14
    held    = close > av
    reclaim = close > dayOpen and close > open
    // a dip during the window that reclaims the open on this bar or a later one
    if dipNear
        dipped := true
    if dipped and held and reclaim
        evEntry := true
        tookDay := true
        ePx := close
        sPx := av - bufAtr * atr14
        risk = ePx - sPx
        sh = risk > 0 ? math.floor(riskUsd / risk) : 0
        label.new(bar_index, low, "Dip & reclaim · day " + str.tostring(dayN) + "\nbuy " + str.tostring(ePx, format.mintick) + " · stop " + str.tostring(sPx, format.mintick) + (riskUsd > 0 ? "\n" + str.tostring(sh) + " sh" : ""),
             style = label.style_label_up, color = color.new(#2997ff, 10), textcolor = color.white, size = size.small)

// ---------------- the trail: daily closes ----------------
var bool below = false
evCut  = false
evBack = false
if started and lastRth and not na(av) and not isAnchor
    if not below and close < av
        below := true
        evCut := true
        label.new(bar_index, high, "Daily close below\ncut at least half", style = label.style_label_down, color = color.new(#ff9f0a, 10), textcolor = color.white, size = size.small)
    else if below and close > av
        below := false
        evBack := true
        label.new(bar_index, low, "Daily close back above\nback on the table", style = label.style_label_up, color = color.new(#30d158, 20), textcolor = color.white, size = size.small)

// ---------------- status panel ----------------
var table pnl = table.new(position.top_right, 1, 3, bgcolor = color.new(#1c1c1e, 10))
if showPanel and barstate.islast
    st = na(av) ? "Pick the anchor bar in the settings" : below ? "Below the line: sellers in control. No long until it reclaims." : close >= av ? "Above the line: buyers in control since the anchor" : "Under the line intraday; the daily close decides"
    dist = na(av) ? "" : "Line " + str.tostring(av, format.mintick) + " · price " + str.tostring((close - av) / av * 100, "+0.0;-0.0") + "% from it"
    table.cell(pnl, 0, 0, "Anchored VWAP" + (useLow ? " · source low" : ""), text_color = color.new(#f5f5f7, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(pnl, 0, 1, st, text_color = color.new(#a1a1a6, 0), text_size = size.small, text_halign = text.align_left)
    table.cell(pnl, 0, 2, dist, text_color = color.new(#a1a1a6, 0), text_size = size.small, text_halign = text.align_left)

// ---------------- alerts ----------------
alertcondition(evEntry, "Dip and reclaim at the line", "Anchored VWAP: {{ticker}} dipped toward the line and reclaimed the open. Stop under the line.")
alertcondition(evCut, "Daily close below the line", "Anchored VWAP: {{ticker}} closed the day below the anchored VWAP. Cut at least half.")
alertcondition(evBack, "Daily close back above the line", "Anchored VWAP: {{ticker}} closed back above the anchored VWAP.")
