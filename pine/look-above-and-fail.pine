//@version=6
// =====================================================================
// Look Above and Fail — thetrademethod.com
//
// A balance-day scalp at the value area edges (look above and fail /
// look below and fail), for intraday futures charts (NQ, ES; 1 to 5
// minutes, 2-minute in the video):
//
//   1. Location    A developing volume profile of New York's regular
//                  hours (9:30-16:00). The value area high and low (70%
//                  of the volume) are the extreme points. For the first
//                  30 minutes the previous day's value area is used.
//   2. Wait        Nothing happens in the middle.
//   3. Aggression  Price trades past an edge with an aggression check:
//                  positive (negative) signed volume of lower time
//                  frame bars, or a volume spike. Pine can't see big
//                  trades or a delta profile, so this is a stand-in.
//   4. The fail    The first trade back inside within N bars is the
//                  aggressive entry, marked at the edge. A later retest
//                  of the edge that closes back inside without a new
//                  extreme is the conservative entry.
//   5. The stop    Past the extreme of the poke, or half the poke when
//                  the extreme leaves under the minimum R (the video).
//   6. Targets     POC (partial, then break even), then the other side
//                  of value. Trades under the minimum R to the other
//                  side are skipped.
//
//   Filters: start after the first 30 minutes, a last-entry time, a
//   daily stop count (three strikes), news blackout times, and a trend
//   check (POC migration).
//
//   The profile is built from the chart's bars: each bar's volume is
//   spread evenly over its range in rows. That's coarser than a tick
//   profile, so levels can differ from your platform's by a row or two.
//   It marks and alerts. It does not place trades.
// =====================================================================
indicator("Look Above and Fail [TTM]", shorttitle = "LAAF", overlay = true, max_lines_count = 400, max_labels_count = 400)

// ---------------------------------------------------------------- inputs
grpP = "Profile"
sessIn   = input.session("0930-1600", "Regular hours (New York)", group = grpP)
rowPts   = input.float(2.0, "Row size (points)", minval = 0.0, step = 0.25, group = grpP, tooltip = "Price per profile row. 2 for NQ, 0.5 for ES is a fair start. 0 = auto (about 1/40 of the 14-day average daily range).")
vaPct    = input.float(70, "Value area %", minval = 50, maxval = 95, group = grpP)
waitMin  = input.int(30, "Let it develop (minutes)", minval = 0, maxval = 120, group = grpP, tooltip = "Before this, signals use the previous day's value area.")

grpS = "Signals"
pokeTk   = input.int(4, "Poke past the edge (ticks)", minval = 1, group = grpS)
failBars = input.int(4, "Back inside within (bars)", minval = 1, maxval = 20, group = grpS, tooltip = "Bars after the poke starts in which a trade back inside counts as the fail.")
modeIn   = input.string("Both", "Entries", options = ["Aggressive", "Conservative", "Both"], group = grpS)
retestTk = input.int(4, "Retest: within (ticks) of the edge", minval = 0, group = grpS)
retestN  = input.int(10, "Retest: within (bars) of the fail", minval = 1, group = grpS)
useAgg   = input.bool(true, "Require an aggression check", group = grpS)
ltfIn    = input.timeframe("1", "Delta from (lower time frame)", group = grpS)
deltaPct = input.float(15, "Delta at least (% of volume)", minval = 0, maxval = 100, group = grpS)
spikeX   = input.float(1.5, "Or volume at least (x 20-bar average)", minval = 1, step = 0.1, group = grpS)

grpR = "Risk and targets"
stopMode = input.string("Extreme, else half", "Stop", options = ["Extreme, else half", "Past the extreme", "Half the poke"], group = grpR, tooltip = "Extreme, else half (the video): past the poke's extreme, or half the poke when the extreme leaves less than the minimum R to the other side. The video puts it just past the big trades, which Pine can't see.")
bufTk    = input.int(2, "Stop buffer (ticks)", minval = 0, group = grpR)
minR     = input.float(2.0, "Minimum R to the other side", minval = 0, step = 0.1, group = grpR)
partPct  = input.float(50, "Partial at POC (%)", minval = 0, maxval = 100, group = grpR)
beAfter  = input.bool(true, "Stop to break even after POC", group = grpR)

grpF = "Filters"
lastIn   = input.session("1000-1530", "Entries allowed (New York)", group = grpF)
maxLoss  = input.int(3, "Stop after this many losses in a day", minval = 1, group = grpF)
newsIn   = input.string("", "News times (HHMM, comma separated)", group = grpF, tooltip = "e.g. 0830,1000,1400. No entries this many minutes either side.")
newsMin  = input.int(10, "News blackout (minutes)", minval = 0, group = grpF)
useTrend = input.bool(true, "Skip when value is migrating", group = grpF)
trendMin = input.int(30, "Migration window (minutes)", minval = 2, group = grpF)
trendPct = input.float(50, "POC moved more than (% of value area)", minval = 0, group = grpF)

grpV = "Display"
showVA   = input.bool(true, "Value area lines", group = grpV)
showPD   = input.bool(true, "Previous day's value area (first 30 minutes)", group = grpV)
showTrd  = input.bool(true, "Stop and target lines", group = grpV)
showTbl  = input.bool(true, "Panel", group = grpV)
colEdge  = input.color(color.rgb(255, 111, 181), "VAH / VAL", group = grpV)
colPoc   = input.color(color.rgb(244, 185, 66), "POC", group = grpV)

// ---------------------------------------------------------------- helpers
TZ = "America/New_York"
tick = syminfo.mintick
inSess = not na(time(timeframe.period, sessIn, TZ))
newSess = inSess and not inSess[1]
minsIn(sess) => not na(time(timeframe.period, sess, TZ))

dailyRange = request.security(syminfo.tickerid, "D", ta.sma(high - low, 14)[1], lookahead = barmerge.lookahead_on)
rowSize = rowPts > 0 ? rowPts : math.max(tick, math.round_to_mintick(nz(dailyRange, 40 * tick) / 40))

// delta stand-in: lower time frame bars' volume signed by their direction
ltfV = request.security_lower_tf(syminfo.tickerid, ltfIn, volume)
ltfD = request.security_lower_tf(syminfo.tickerid, ltfIn, close > open ? 1.0 : close < open ? -1.0 : 0.0)
float dlt = 0.0
if ltfV.size() > 0 and ltfV.size() == ltfD.size()
    for [i, v] in ltfV
        dlt += nz(v) * ltfD.get(i)
else
    dlt := close > open ? volume : close < open ? -volume : 0.0
volAvg = ta.sma(volume, 20)
aggUp = not useAgg or (volume > 0 and nz(dlt) >= deltaPct / 100 * volume) or volume >= spikeX * nz(volAvg, volume)
aggDn = not useAgg or (volume > 0 and -nz(dlt) >= deltaPct / 100 * volume) or volume >= spikeX * nz(volAvg, volume)

// news times "0830,1000" -> minutes of day
var array<int> newsT = array.new<int>()
if barstate.isfirst and str.length(newsIn) > 0
    for s in str.split(newsIn, ",")
        t = str.tonumber(str.trim(s))
        if not na(t)
            newsT.push(int(math.floor(t / 100)) * 60 + int(t % 100))
nyMin = hour(time, TZ) * 60 + minute(time, TZ)
inNews() =>
    bool hit = false
    if newsT.size() > 0
        for t in newsT
            if math.abs(nyMin - t) <= newsMin
                hit := true
    hit

// ---------------------------------------------------------------- the developing profile
var map<int, float> prof = map.new<int, float>()
var int sessStart = na
var float vah = na
var float val = na
var float poc = na
var float pdVah = na
var float pdVal = na
var float pdPoc = na

if newSess
    pdVah := vah
    pdVal := val
    pdPoc := poc
    prof.clear()
    sessStart := time
    vah := na
    val := na
    poc := na

if inSess and volume > 0
    int lo = int(math.floor(low / rowSize))
    int hi = int(math.floor((high - tick / 2) / rowSize))
    int n = math.max(1, hi - lo + 1)
    float share = volume / n
    for k = lo to math.max(lo, hi)
        prof.put(k, nz(prof.get(k)) + share)
    // POC and value area
    keys = prof.keys()
    float tot = 0.0
    int pk = na
    float pv = -1.0
    int kmin = na
    int kmax = na
    for k in keys
        v = prof.get(k)
        tot += v
        if v > pv
            pv := v
            pk := k
        kmin := na(kmin) ? k : math.min(kmin, k)
        kmax := na(kmax) ? k : math.max(kmax, k)
    int a = pk
    int b = pk
    float acc = pv
    while acc < vaPct / 100 * tot and (a > kmin or b < kmax)
        float up = b < kmax ? nz(prof.get(b + 1)) : -1.0
        float dn = a > kmin ? nz(prof.get(a - 1)) : -1.0
        if up >= dn
            b += 1
            acc += math.max(up, 0)
        else
            a -= 1
            acc += math.max(dn, 0)
    poc := pk * rowSize + rowSize / 2
    vah := (b + 1) * rowSize
    val := a * rowSize

developed = inSess and not na(sessStart) and (time - sessStart) >= waitMin * 60000
// the levels signals use: today's after the wait, yesterday's before
useToday = developed
eVah = useToday ? vah : pdVah
eVal = useToday ? val : pdVal
ePoc = useToday ? poc : pdPoc

// POC migration (trend check)
var float[] pocHist = array.new<float>()
var int[] pocTime = array.new<int>()
if newSess
    pocHist.clear()
    pocTime.clear()
if inSess and not na(poc)
    pocHist.push(poc)
    pocTime.push(time)
    while pocTime.size() > 0 and time - pocTime.first() > trendMin * 60000
        pocHist.shift()
        pocTime.shift()
migrating = useTrend and developed and pocHist.size() > 1 and not na(vah) and (vah - val) > 0 and math.abs(poc - pocHist.first()) > trendPct / 100 * (vah - val)

// ---------------------------------------------------------------- state
var int lossesToday = 0
if newSess
    lossesToday := 0

// a poke: 1 = look above (short side), -1 = look below (long side)
var int pokeDir = 0
var int pokeBar = na
var float pokeExt = na
var bool pokeAgg = false
var float pokeEdge = na
// after a fail, waiting for a retest (conservative)
var int failDir = 0
var int failBar = na
var float failExt = na
var float failEdge = na
// the open trade
var int tDir = 0
var float tEntry = na
var float tStop = na
var float tPoc = na
var float tOther = na
var float tRisk = na
var bool tHalf = false
var line lStop = na
var line lPoc = na
var line lOther = na
// stats
var int nTrades = 0
var int nWins = 0
var float sumR = 0.0

okTime = minsIn(lastIn) and inSess
canEnter = okTime and tDir == 0 and lossesToday < maxLoss and not inNews() and not migrating and not na(eVah) and not na(eVal) and eVah > eVal

// manage the open trade first (stop checked before targets: worst case)
float closedR = na
if tDir != 0
    bool hitStop = tDir == 1 ? low <= tStop : high >= tStop
    bool hitPoc = not tHalf and (tDir == 1 ? high >= tPoc : low <= tPoc)
    bool hitOther = tDir == 1 ? high >= tOther : low <= tOther
    float rPoc = math.abs(tPoc - tEntry) / tRisk
    float rOther = math.abs(tOther - tEntry) / tRisk
    float part = partPct / 100
    if hitStop
        float rStop = (tStop - tEntry) * tDir / tRisk
        closedR := tHalf ? part * rPoc + (1 - part) * rStop : rStop
    else
        if hitPoc
            tHalf := true
            if beAfter
                tStop := tEntry
                if showTrd and not na(lStop)
                    lStop.set_y1(tEntry)
                    lStop.set_y2(tEntry)
        if hitOther
            closedR := (tHalf ? part * rPoc : 0.0) + (tHalf ? 1 - part : 1.0) * rOther
        else if not inSess
            float rNow = (close - tEntry) * tDir / tRisk
            closedR := tHalf ? part * rPoc + (1 - part) * rNow : rNow
    if showTrd and not na(lStop)
        lStop.set_x2(bar_index)
        lPoc.set_x2(bar_index)
        lOther.set_x2(bar_index)
if not na(closedR)
    nTrades += 1
    sumR += closedR
    if closedR > 0
        nWins += 1
    if closedR < 0
        lossesToday += 1
    tDir := 0

planTrade(int dir, float entry, float ext, float edge) =>
    // dir = -1 short (stop above), +1 long (stop below)
    float half = edge + (ext - edge) / 2
    float other = dir == -1 ? eVal : eVah
    float base = stopMode == "Half the poke" ? half : ext
    float stop = dir == -1 ? base + bufTk * tick : base - bufTk * tick
    float risk = math.abs(entry - stop)
    float rr = risk > 0 ? (other - entry) * dir / risk : 0.0
    // the video: when the extreme is too far for the minimum R, risk half the poke instead
    if stopMode == "Extreme, else half" and rr < minR
        stop := dir == -1 ? half + bufTk * tick : half - bufTk * tick
        risk := math.abs(entry - stop)
        rr := risk > 0 ? (other - entry) * dir / risk : 0.0
    [risk > 0 and rr >= minR, stop, risk, other, rr]

// --- new pokes
if canEnter and pokeDir == 0
    if high >= eVah + pokeTk * tick
        pokeDir := 1
        pokeBar := bar_index
        pokeExt := high
        pokeAgg := aggUp
        pokeEdge := eVah
    else if low <= eVal - pokeTk * tick
        pokeDir := -1
        pokeBar := bar_index
        pokeExt := low
        pokeAgg := aggDn
        pokeEdge := eVal

int nDir = 0
float nEntry = na
float nStop = na
float nRisk = na
float nOther = na
bool sigAggShort = false
bool sigAggLong = false
bool sigConShort = false
bool sigConLong = false
float sigR = na

if pokeDir != 0
    // keep the extreme and the aggression check up to date
    if bar_index > pokeBar
        pokeExt := pokeDir == 1 ? math.max(pokeExt, high) : math.min(pokeExt, low)
        pokeAgg := pokeAgg or (pokeDir == 1 ? (close > pokeEdge and aggUp) : (close < pokeEdge and aggDn))
    bool back = pokeDir == 1 ? (bar_index > pokeBar ? low < pokeEdge : close < pokeEdge) : (bar_index > pokeBar ? high > pokeEdge : close > pokeEdge)
    if back and pokeAgg
        if modeIn != "Conservative" and canEnter
            float entry = pokeDir == 1 ? pokeEdge - tick : pokeEdge + tick
            [ok, stp, rsk, oth, rr] = planTrade(-pokeDir, entry, pokeExt, pokeEdge)
            if ok
                nDir := -pokeDir
                nEntry := entry
                nStop := stp
                nRisk := rsk
                nOther := oth
                sigR := rr
                if pokeDir == 1
                    sigAggShort := true
                else
                    sigAggLong := true
        if nDir == 0 and modeIn != "Aggressive"
            failDir := pokeDir
            failBar := bar_index
            failExt := pokeExt
            failEdge := pokeEdge
        pokeDir := 0
    else if bar_index - pokeBar >= failBars or (back and not pokeAgg)
        pokeDir := 0

// --- conservative: the retest of the edge holds
if failDir != 0 and bar_index > failBar
    bool newExt = failDir == 1 ? high > failExt : low < failExt
    bool touched = failDir == 1 ? high >= failEdge - retestTk * tick : low <= failEdge + retestTk * tick
    bool held = failDir == 1 ? close < failEdge : close > failEdge
    if newExt or bar_index - failBar > retestN or tDir != 0 or nDir != 0
        failDir := 0
    else if touched and held and canEnter
        [ok, stp, rsk, oth, rr] = planTrade(-failDir, close, failExt, failEdge)
        if ok
            nDir := -failDir
            nEntry := close
            nStop := stp
            nRisk := rsk
            nOther := oth
            sigR := rr
            if failDir == 1
                sigConShort := true
            else
                sigConLong := true
        failDir := 0

// open the new trade
if nDir != 0
    tDir := nDir
    tEntry := nEntry
    tStop := nStop
    tPoc := ePoc
    tOther := nOther
    tRisk := nRisk
    tHalf := false
    if showTrd
        lStop := line.new(bar_index, nStop, bar_index + 1, nStop, color = color.rgb(255, 69, 58), style = line.style_dashed, width = 2)
        lPoc := line.new(bar_index, ePoc, bar_index + 1, ePoc, color = colPoc, style = line.style_dotted, width = 2)
        lOther := line.new(bar_index, nOther, bar_index + 1, nOther, color = color.rgb(34, 211, 238), style = line.style_dotted, width = 2)

// ---------------------------------------------------------------- drawing
pVah = plot(showVA and inSess and developed ? vah : na, "Value area high", colEdge, 2, plot.style_linebr)
pVal = plot(showVA and inSess and developed ? val : na, "Value area low", colEdge, 2, plot.style_linebr)
plot(showVA and inSess and developed ? poc : na, "POC", colPoc, 1, plot.style_linebr)
plot(showPD and inSess and not developed ? pdVah : na, "Previous VAH", color.new(color.rgb(191, 90, 242), 0), 1, plot.style_linebr)
plot(showPD and inSess and not developed ? pdVal : na, "Previous VAL", color.new(color.rgb(191, 90, 242), 0), 1, plot.style_linebr)
fill(pVah, pVal, color.new(colEdge, 94), "Value area")

plotshape(sigAggShort, "Look above and fail (aggressive)", shape.triangledown, location.abovebar, color.rgb(255, 69, 58), size = size.small, text = "LAF")
plotshape(sigConShort, "Look above and fail (conservative)", shape.triangledown, location.abovebar, color.rgb(255, 159, 10), size = size.small, text = "LAF c")
plotshape(sigAggLong, "Look below and fail (aggressive)", shape.triangleup, location.belowbar, color.rgb(48, 209, 88), size = size.small, text = "LBF")
plotshape(sigConLong, "Look below and fail (conservative)", shape.triangleup, location.belowbar, color.rgb(255, 159, 10), size = size.small, text = "LBF c")
bgcolor(inSess and not developed ? color.new(color.gray, 94) : na, title = "First 30 minutes")

// ---------------------------------------------------------------- alerts
alertcondition(sigAggShort, "Look above and fail: short", "Look above and fail: back under the value area high. Short.")
alertcondition(sigAggLong, "Look below and fail: long", "Look below and fail: back over the value area low. Long.")
alertcondition(sigConShort, "Look above and fail: retest short", "Retest of the value area high held. Conservative short.")
alertcondition(sigConLong, "Look below and fail: retest long", "Retest of the value area low held. Conservative long.")
alertcondition(pokeDir == 1 and pokeBar == bar_index, "Look above", "Price is trading over the value area high.")
alertcondition(pokeDir == -1 and pokeBar == bar_index, "Look below", "Price is trading under the value area low.")
if sigAggShort or sigConShort or sigAggLong or sigConLong
    alert((sigAggShort or sigConShort ? "Look above and fail short" : "Look below and fail long") + " on " + syminfo.ticker + ". Entry " + str.tostring(tEntry, format.mintick) + ", stop " + str.tostring(tStop, format.mintick) + ", POC " + str.tostring(tPoc, format.mintick) + ", other side " + str.tostring(tOther, format.mintick) + " (" + str.tostring(sigR, "#.##") + "R).", alert.freq_once_per_bar)

// ---------------------------------------------------------------- panel
var table tb = table.new(position.top_right, 2, 7, bgcolor = color.new(#1d1d1f, 8), border_width = 0, frame_color = color.new(#3a3a3c, 0), frame_width = 1)
if showTbl and barstate.islast
    string state = not inSess ? "Session closed" : not developed ? "First " + str.tostring(waitMin) + " min · yesterday's levels" : migrating ? "Value migrating · skip" : lossesToday >= maxLoss ? "Three strikes · done" : tDir != 0 ? (tDir == 1 ? "In a long" : "In a short") : pokeDir == 1 ? "Look above · watching" : pokeDir == -1 ? "Look below · watching" : (close > eVah or close < eVal) ? "Outside value" : "Inside value · wait"
    table.cell(tb, 0, 0, "Look Above and Fail", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 0, state, text_color = color.rgb(209, 209, 214), text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 1, "VAH", text_color = colEdge, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 1, str.tostring(eVah, format.mintick), text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 2, "POC", text_color = colPoc, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 2, str.tostring(ePoc, format.mintick), text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 3, "VAL", text_color = colEdge, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 3, str.tostring(eVal, format.mintick), text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 4, "Losses today", text_color = color.rgb(209, 209, 214), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 4, str.tostring(lossesToday) + " / " + str.tostring(maxLoss), text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 5, "Trades · wins", text_color = color.rgb(209, 209, 214), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 5, str.tostring(nTrades) + " · " + str.tostring(nWins), text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 6, "Average R", text_color = color.rgb(209, 209, 214), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 6, nTrades > 0 ? str.tostring(sumR / nTrades, "#.##") : "-", text_color = color.white, text_size = size.small, text_halign = text.align_right)
