//@version=6
// =====================================================================
// Fibonacci OTE — thetrademethod.com
//
// Strategy one from the Fibonacci OTE page (Com Lucro Trader's
// "Fibonacci Retracement + OTE"), for any market and time frame
// (1-hour in the video):
//
//   1. Trend      Swing highs and lows (pivots). A close above the last
//                 swing high is a break of structure up: buys only. A
//                 close below the last swing low: sells only.
//   2. The fib    On the latest impulse: 1 on the swing it started from
//                 (A), 0 on its end (B). While price keeps making new
//                 extremes, B moves with it.
//   3. Room       Higher time frame swing levels. If the nearest one
//                 ahead of B is too close, the setup is skipped.
//   4. The order  A limit at 0.702, the middle of the OTE (0.618 to
//                 0.786), in discount for a buy, premium for a sell.
//   5. The stop   Past A, by a buffer.
//   6. Targets    TP1 a little short of B (half, then the stop goes to
//                 entry), TP2 the next higher time frame level (or a
//                 fib extension if there is none).
//
//   A pullback that reaches 0.382 fixes the range. If price then makes
//   a new extreme without filling the order, that setup is marked
//   "no fill" and the next impulse is measured from the pullback.
//
//   A break the other way while a trade is open doesn't touch that
//   trade. When it closes, the new direction is armed from the swing
//   the break started at (Nov 2026 fix: the video's gold long, Mar 27
//   2026, was missed before it).
//
//   Level filter (off by default, Nov 2026): take the setup only when
//   a support/resistance level sits near the OTE zone. Levels follow
//   the "Support & Resistance (5-MTF)" rules: 15-bar pivots on the
//   1-hour and 4-hour charts, broken on a close through, a broken level
//   flips once (support turned resistance and back). In our test on 32
//   stocks and ETFs (2021 to 2026) this lifted longs from about break
//   even to +0.67R a trade (84 trades, random entries +0.05R); shorts
//   stayed flat. A small sample: treat it as a lead, not a rule.
//
//   It marks and alerts. It does not place trades.
// =====================================================================
indicator("Fibonacci OTE [TTM]", shorttitle = "Fib OTE", overlay = true, max_lines_count = 300, max_labels_count = 300, max_boxes_count = 50, max_bars_back = 1000)

// ---------------------------------------------------------------- inputs
grpT = "Trend and swings"
pivLen   = input.int(5, "Swing strength (bars each side)", minval = 1, maxval = 50, group = grpT)
maxLook  = input.int(300, "Look back for the swing (bars)", minval = 20, maxval = 990, group = grpT)

grpF = "Fib and order"
entryLvl = input.float(0.702, "Entry level", options = [0.618, 0.702, 0.786], group = grpF, tooltip = "0.702 is the middle of the OTE, the strategy's limit order. 0.618 fills more often; 0.786 has the best ratio and misses more.")
validLvl = input.float(0.382, "A real pullback reaches", minval = 0.1, maxval = 0.6, step = 0.001, group = grpF, tooltip = "Pullbacks that never reach this are noise: the impulse is still one leg.")
minImp   = input.float(0.0, "Smallest impulse (x ATR 14)", minval = 0, step = 0.5, group = grpF, tooltip = "0 = any size. Skips impulses smaller than this many ATRs.")

grpR = "Risk and targets"
bufTk    = input.int(10, "Stop past the swing by (ticks)", minval = 0, group = grpR)
tp1Pct   = input.float(6.0, "TP1: short of the old extreme by (% of the impulse)", minval = 0, maxval = 50, step = 0.5, group = grpR)
htfIn    = input.timeframe("240", "Higher time frame for room and TP2", group = grpR)
htfLen   = input.int(3, "Higher time frame swing strength", minval = 1, maxval = 20, group = grpR)
roomPct  = input.float(30, "Need room of at least (% of the impulse)", minval = 0, maxval = 300, group = grpR, tooltip = "Distance from B to the nearest higher time frame level ahead. Less than this and the setup is skipped. 0 turns the check off.")
extMult  = input.float(0.618, "TP2 if no level ahead: extension (x impulse)", minval = 0.1, step = 0.1, group = grpR)

grpL = "Level filter (off by default)"
useLvl   = input.bool(false, "Only take setups near a support/resistance level", group = grpL, tooltip = "A level from the time frames below must sit inside the 0.618 to 0.786 zone, give or take the tolerance. Our test: it helped longs, not shorts.")
lvlTf1On = input.bool(true, "Level time frame 1", group = grpL, inline = "l1")
lvlTf1   = input.timeframe("60", "", group = grpL, inline = "l1")
lvlTf2On = input.bool(true, "Level time frame 2", group = grpL, inline = "l2")
lvlTf2   = input.timeframe("240", "", group = grpL, inline = "l2")
lvlPiv   = input.int(15, "Level pivot length (bars each side)", minval = 3, maxval = 50, group = grpL)
lvlFlip  = input.bool(true, "Keep broken levels (they flip once)", group = grpL, tooltip = "A support that closes below stays on as resistance, once (and the other way round). Without this the filter didn't help in our test.")
lvlTol   = input.float(15, "Tolerance around the zone (% of the impulse)", minval = 0, maxval = 50, step = 1, group = grpL)
sideIn   = input.string("Longs and shorts", "Take", options = ["Longs and shorts", "Longs only", "Shorts only"], group = grpL)

grpD = "Display"
showFib  = input.bool(true, "Fib levels", group = grpD)
showPD   = input.bool(true, "Premium and discount shading", group = grpD)
showBos  = input.bool(true, "Break of structure labels", group = grpD)
showTbl  = input.bool(true, "Status table", group = grpD)
extBars  = input.int(15, "Extend lines right (bars)", minval = 0, maxval = 100, group = grpD)
cUp      = input.color(color.new(#30d158, 0), "Long", group = grpD)
cDn      = input.color(color.new(#ff453a, 0), "Short", group = grpD)
cGold    = input.color(color.new(#f4b942, 0), "OTE", group = grpD)
cTgt     = input.color(color.new(#22d3ee, 0), "Targets", group = grpD)

// ---------------------------------------------------------------- helpers
tick = syminfo.mintick
fibAt(float a, float b, float r) => b - r * (b - a)      // a = the 1, b = the 0
fmt(float v) => str.tostring(v, format.mintick)
atr14 = ta.atr(14)

// ---------------------------------------------------------------- swings on the chart
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
var float lastPH = na
var int   lastPHb = na
var float lastPL = na
var int   lastPLb = na
if not na(ph)
    lastPH := ph
    lastPHb := bar_index - pivLen
if not na(pl)
    lastPL := pl
    lastPLb := bar_index - pivLen

// ---------------------------------------------------------------- higher time frame levels
[hPH, hPL] = request.security(syminfo.tickerid, htfIn, [ta.pivothigh(high, htfLen, htfLen), ta.pivotlow(low, htfLen, htfLen)], lookahead = barmerge.lookahead_off)
var array<float> htfHi = array.new<float>()
var array<float> htfLo = array.new<float>()
if not na(hPH) and (htfHi.size() == 0 or htfHi.last() != hPH)
    htfHi.push(hPH)
    if htfHi.size() > 40
        htfHi.shift()
if not na(hPL) and (htfLo.size() == 0 or htfLo.last() != hPL)
    htfLo.push(hPL)
    if htfLo.size() > 40
        htfLo.shift()

// support/resistance levels ("Support & Resistance (5-MTF)" rules), on each level time frame's own bars
srLevels(int len, bool flip) =>
    var array<float> pr = array.new<float>()
    var array<int>   ty = array.new<int>()      // 1 = resistance, -1 = support
    var array<bool>  br = array.new<bool>()
    var array<bool>  ep = array.new<bool>()     // a flipped copy (flips only once)
    a20 = ta.atr(20)
    pH = ta.pivothigh(high, len, len)
    pL = ta.pivotlow(low, len, len)
    if not na(pL)
        ok = true
        if pr.size() > 0
            for i = 0 to pr.size() - 1
                if not br.get(i) and math.abs(pr.get(i) - pL) < nz(a20) / 8
                    ok := false
        if ok
            pr.unshift(pL), ty.unshift(-1), br.unshift(false), ep.unshift(false)
            while pr.size() > 10
                pr.pop(), ty.pop(), br.pop(), ep.pop()
    if not na(pH)
        pr.unshift(pH), ty.unshift(1), br.unshift(false), ep.unshift(false)
        while pr.size() > 10
            pr.pop(), ty.pop(), br.pop(), ep.pop()
    array<float> nP = array.new<float>()
    array<int>   nT = array.new<int>()
    if pr.size() > 0
        for i = 0 to pr.size() - 1
            if not br.get(i) and ((ty.get(i) == 1 and close > pr.get(i)) or (ty.get(i) == -1 and close < pr.get(i)))
                br.set(i, true)
                if flip and not ep.get(i)
                    nP.push(pr.get(i)), nT.push(-ty.get(i))
    if nP.size() > 0
        for i = 0 to nP.size() - 1
            pr.unshift(nP.get(i)), ty.unshift(nT.get(i)), br.unshift(false), ep.unshift(true)
    array<float> out = array.new<float>()
    if pr.size() > 0
        for i = 0 to pr.size() - 1
            if not br.get(i)
                out.push(pr.get(i))
    out

array<float> lv1r = request.security(syminfo.tickerid, lvlTf1, srLevels(lvlPiv, lvlFlip), lookahead = barmerge.lookahead_off)
array<float> lv2r = request.security(syminfo.tickerid, lvlTf2, srLevels(lvlPiv, lvlFlip), lookahead = barmerge.lookahead_off)
array<float> lv1 = lvlTf1On ? lv1r : array.new<float>()
array<float> lv2 = lvlTf2On ? lv2r : array.new<float>()

// is there a level in [lo, hi]?
levelIn(float lo, float hi) =>
    bool f = false
    if not na(lv1)
        for v in lv1
            if v >= lo and v <= hi
                f := true
    if not na(lv2)
        for v in lv2
            if v >= lo and v <= hi
                f := true
    f

// nearest higher time frame level ahead of x (above for d = 1, below for d = -1)
nearestAhead(float x, int d) =>
    float best = na
    if d == 1
        for v in htfHi
            if v > x and (na(best) or v < best)
                best := v
    else
        for v in htfLo
            if v < x and (na(best) or v > best)
                best := v
    best

// extreme over the last n bars (n >= 0), and how many bars back it was
lowestBack(int n) =>
    float m = low
    int k = 0
    for i = 0 to math.min(n, 990)
        if low[i] < m
            m := low[i]
            k := i
    [m, k]
highestBack(int n) =>
    float m = high
    int k = 0
    for i = 0 to math.min(n, 990)
        if high[i] > m
            m := high[i]
            k := i
    [m, k]

// ---------------------------------------------------------------- state
// st: 0 = nothing, 1 = order working (the leg), 2 = in the trade
var int   dir   = 0
var int   st    = 0
var float A     = na
var int   aBar  = na
var float B     = na
var int   bBar  = na
var float pbX   = na      // pullback extreme since B
var int   pbBar = na
var bool  valid = false   // pullback reached the 0.382
var float E     = na
var float S     = na
var float T1    = na
var float T2    = na
var bool  room  = true
var bool  hit1  = false
var float stopNow = na
var int   tDir  = 0       // the open trade's own direction (a break the other way doesn't flip it)

var int   pendDir = 0     // a break of structure that came while a trade was open
var float pendA   = na
var int   pendAb  = na

var int nWin = 0
var int nBE  = 0
var int nLoss = 0
var int nMiss = 0

// levels for the current A, B
calcLevels() =>
    e  = fibAt(A, B, entryLvl)
    s  = dir == 1 ? A - bufTk * tick : A + bufTk * tick
    t1 = B - dir * (tp1Pct / 100) * math.abs(B - A)
    lv = nearestAhead(B, dir)
    t2 = na(lv) ? B + dir * extMult * math.abs(B - A) : lv
    rm = roomPct <= 0 or na(lv) or math.abs(lv - B) >= (roomPct / 100) * math.abs(B - A)
    big = minImp <= 0 or math.abs(B - A) >= minImp * atr14
    zt = (lvlTol / 100) * math.abs(B - A)
    lvOk = not useLvl or levelIn(math.min(fibAt(A, B, 0.618), fibAt(A, B, 0.786)) - zt, math.max(fibAt(A, B, 0.618), fibAt(A, B, 0.786)) + zt)
    sdOk = sideIn == "Longs and shorts" or (sideIn == "Longs only" and dir == 1) or (sideIn == "Shorts only" and dir == -1)
    [e, s, t1, t2, rm and big and lvOk and sdOk]

skipWhy() =>
    lv = nearestAhead(B, dir)
    rm = roomPct <= 0 or na(lv) or math.abs(lv - B) >= (roomPct / 100) * math.abs(B - A)
    sdOk = sideIn == "Longs and shorts" or (sideIn == "Longs only" and dir == 1) or (sideIn == "Shorts only" and dir == -1)
    not sdOk ? "skip: other side" : not rm ? "skip: no room" : (minImp > 0 and math.abs(B - A) < minImp * atr14) ? "skip: small impulse" : "skip: no level near"

// ---------------------------------------------------------------- break of structure
bosUp = not na(lastPH) and close > lastPH and close[1] <= lastPH
bosDn = not na(lastPL) and close < lastPL and close[1] >= lastPL

evFill  = false
evT1    = false
evT2    = false
evStop  = false
evMiss  = false
evArm   = false
evBos   = 0

if bosUp and dir != 1
    evBos := 1
    if st == 1
        st := 0
    if st != 2
        [lo, k] = lowestBack(math.min(bar_index - lastPHb, maxLook))
        [hi, kh] = highestBack(k)
        dir := 1
        st := 1
        A := lo
        aBar := bar_index - k
        B := hi
        bBar := bar_index - kh
        pbX := na
        pbBar := na
        valid := false
        evArm := true
        pendDir := 0
    else
        // in a trade: remember where the new impulse started, arm it when the trade ends
        [lo, k] = lowestBack(math.min(bar_index - lastPHb, maxLook))
        pendDir := 1, pendA := lo, pendAb := bar_index - k
        dir := 1
    lastPH := na
else if bosDn and dir != -1
    evBos := -1
    if st == 1
        st := 0
    if st != 2
        [hi, k] = highestBack(math.min(bar_index - lastPLb, maxLook))
        [lo, kl] = lowestBack(k)
        dir := -1
        st := 1
        A := hi
        aBar := bar_index - k
        B := lo
        bBar := bar_index - kl
        pbX := na
        pbBar := na
        valid := false
        evArm := true
        pendDir := 0
    else
        [hi, k] = highestBack(math.min(bar_index - lastPLb, maxLook))
        pendDir := -1, pendA := hi, pendAb := bar_index - k
        dir := -1
    lastPL := na

// ---------------------------------------------------------------- the leg: order working
if st == 1 and evBos == 0
    [e0, s0, t10, t20, r0] = calcLevels()
    newExt = dir == 1 ? high > B : low < B
    if newExt
        if valid
            // a real pullback came and went without the order: no fill, measure from the pullback
            evMiss := true
            nMiss += 1
            label.new(pbBar, pbX, "no fill", style = dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 30), textcolor = color.white, size = size.small)
            A := pbX
            aBar := pbBar
        B := dir == 1 ? high : low
        bBar := bar_index
        pbX := na
        pbBar := na
        valid := false
    else
        ext = dir == 1 ? low : high
        if na(pbX) or (dir == 1 ? ext < pbX : ext > pbX)
            pbX := ext
            pbBar := bar_index
        if not valid and (dir == 1 ? pbX <= fibAt(A, B, validLvl) : pbX >= fibAt(A, B, validLvl))
            valid := true
        touched = dir == 1 ? low <= e0 : high >= e0
        if touched and bar_index > bBar
            if r0
                st := 2
                E := e0, S := s0, T1 := t10, T2 := t20, stopNow := s0, hit1 := false, tDir := dir
                evFill := true
                label.new(bar_index, E, (dir == 1 ? "buy " : "sell ") + fmt(E), style = dir == 1 ? label.style_label_upper_left : label.style_label_lower_left, color = cGold, textcolor = color.black, size = size.small)
            else
                // skipped for room (or size): wait for the next impulse
                label.new(bar_index, e0, skipWhy(), style = dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 30), textcolor = color.white, size = size.small)
                st := 0

// ---------------------------------------------------------------- in the trade
if st == 2 and not evFill
    hitStop = tDir == 1 ? low <= stopNow : high >= stopNow
    hitT1   = tDir == 1 ? high >= T1 : low <= T1
    hitT2   = tDir == 1 ? high >= T2 : low <= T2
    if hitStop
        evStop := true
        if hit1
            nBE += 1
            label.new(bar_index, stopNow, "break even", style = tDir == 1 ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.small)
        else
            nLoss += 1
            label.new(bar_index, stopNow, "stop -1R", style = tDir == 1 ? label.style_label_up : label.style_label_down, color = cDn, textcolor = color.white, size = size.small)
        st := 0
    else
        if not hit1 and hitT1
            hit1 := true
            stopNow := E
            evT1 := true
            label.new(bar_index, T1, "TP1 · half · stop to entry", style = tDir == 1 ? label.style_label_down : label.style_label_up, color = cTgt, textcolor = color.black, size = size.small)
        if hit1 and hitT2
            evT2 := true
            nWin += 1
            r = (math.abs(T1 - E) + math.abs(T2 - E)) / 2 / math.abs(E - S)
            label.new(bar_index, T2, "TP2 · " + str.tostring(r, "#.##") + "R", style = tDir == 1 ? label.style_label_down : label.style_label_up, color = cTgt, textcolor = color.black, size = size.small)
            st := 0

// a trade that ended after the trend flipped: arm the new direction from the swing the break started at
if st == 0 and pendDir != 0 and pendDir == dir
    n = math.min(bar_index - pendAb, maxLook)
    if dir == 1
        [hi, kh] = highestBack(n)
        B := hi, bBar := bar_index - kh
    else
        [lo, kl] = lowestBack(n)
        B := lo, bBar := bar_index - kl
    A := pendA, aBar := pendAb
    pbX := na, pbBar := na, valid := false
    st := 1
    pendDir := 0
    evArm := true
else if st == 0 and pendDir != 0
    pendDir := 0

// after a trade (or a skip) in the same trend, measure the next impulse from the latest pullback
if st == 0 and dir != 0 and evBos == 0 and not evStop and not evT2 and not na(B) and not evArm
    newExt2 = dir == 1 ? high > B : low < B
    if newExt2
        n = math.min(bar_index - bBar, maxLook)
        if dir == 1
            [lo, k] = lowestBack(n)
            A := lo, aBar := bar_index - k
            B := high
        else
            [hi, k] = highestBack(n)
            A := hi, aBar := bar_index - k
            B := low
        bBar := bar_index
        pbX := na, pbBar := na, valid := false
        st := 1
        evArm := true

// ---------------------------------------------------------------- drawing (the current setup only)
var line lA = line.new(na, na, na, na, color = color.gray, style = line.style_dotted)
var array<line> fl = array.new<line>()
var array<label> fLab = array.new<label>()
var box bPrem = box.new(na, na, na, na, border_color = color.new(color.black, 100), bgcolor = color.new(#ff453a, 92))
var box bDisc = box.new(na, na, na, na, border_color = color.new(color.black, 100), bgcolor = color.new(#30d158, 92))
var box bOte  = box.new(na, na, na, na, border_color = color.new(color.black, 100), bgcolor = color.new(#f4b942, 82))
var line lE  = line.new(na, na, na, na, color = cGold, width = 2)
var line lS  = line.new(na, na, na, na, color = cDn, style = line.style_dashed)
var line lT1 = line.new(na, na, na, na, color = cTgt, style = line.style_dotted)
var line lT2 = line.new(na, na, na, na, color = cTgt, style = line.style_dotted)
RAT = array.from(0.0, 0.382, 0.5, 0.618, 0.702, 0.786, 1.0)
if fl.size() == 0
    for i = 0 to 6
        fl.push(line.new(na, na, na, na, color = color.gray, style = line.style_dashed))
        fLab.push(label.new(na, na, "", style = label.style_none, textcolor = color.gray, size = size.small))

if barstate.islast
    xr = bar_index + extBars
    on = st >= 1 and not na(A) and not na(B)
    if on and showFib
        mid = fibAt(A, B, 0.5)
        line.set_xy1(lA, aBar, A), line.set_xy2(lA, bBar, B)
        for i = 0 to 6
            r = RAT.get(i)
            p = fibAt(A, B, r)
            c = r >= 0.618 and r <= 0.786 ? cGold : r == 0.5 ? color.white : color.gray
            ln = fl.get(i)
            line.set_xy1(ln, aBar, p), line.set_xy2(ln, xr, p), line.set_color(ln, c)
            line.set_style(ln, r == entryLvl ? line.style_solid : line.style_dashed)
            lb = fLab.get(i)
            label.set_xy(lb, xr, p), label.set_text(lb, str.tostring(r) + "  " + fmt(p)), label.set_textcolor(lb, c), label.set_style(lb, label.style_label_left)
            label.set_color(lb, color.new(color.black, 100))
        box.set_lefttop(bOte, aBar, math.max(fibAt(A, B, 0.618), fibAt(A, B, 0.786)))
        box.set_rightbottom(bOte, xr, math.min(fibAt(A, B, 0.618), fibAt(A, B, 0.786)))
        if showPD
            box.set_lefttop(bPrem, aBar, math.max(A, B)), box.set_rightbottom(bPrem, xr, mid)
            box.set_lefttop(bDisc, aBar, mid), box.set_rightbottom(bDisc, xr, math.min(A, B))
            if dir == -1
                // bearish: premium is still the top half
                box.set_lefttop(bPrem, aBar, A), box.set_rightbottom(bPrem, xr, mid)
                box.set_lefttop(bDisc, aBar, mid), box.set_rightbottom(bDisc, xr, B)
    else
        line.set_xy1(lA, na, na), line.set_xy2(lA, na, na)
        for i = 0 to 6
            line.set_xy1(fl.get(i), na, na), line.set_xy2(fl.get(i), na, na)
            label.set_xy(fLab.get(i), na, na)
        box.set_lefttop(bOte, na, na), box.set_rightbottom(bOte, na, na)
        box.set_lefttop(bPrem, na, na), box.set_rightbottom(bPrem, na, na)
        box.set_lefttop(bDisc, na, na), box.set_rightbottom(bDisc, na, na)
    if not showPD or not on
        box.set_lefttop(bPrem, na, na), box.set_rightbottom(bPrem, na, na)
        box.set_lefttop(bDisc, na, na), box.set_rightbottom(bDisc, na, na)
    // the order or the trade
    [e1, s1, t11, t21, r1] = calcLevels()
    showE = st == 2 ? E : st == 1 and not na(A) ? e1 : float(na)
    showS = st == 2 ? stopNow : st == 1 and not na(A) ? s1 : float(na)
    show1 = st == 2 ? T1 : st == 1 and not na(A) ? t11 : float(na)
    show2 = st == 2 ? T2 : st == 1 and not na(A) ? t21 : float(na)
    x0 = st == 2 ? bar_index - 5 : bBar
    line.set_xy1(lE, x0, showE), line.set_xy2(lE, xr, showE)
    line.set_style(lE, st == 1 and not r1 ? line.style_dotted : line.style_solid)
    line.set_xy1(lS, x0, showS), line.set_xy2(lS, xr, showS)
    line.set_xy1(lT1, x0, show1), line.set_xy2(lT1, xr, show1)
    line.set_xy1(lT2, x0, show2), line.set_xy2(lT2, xr, show2)

// ---------------------------------------------------------------- break of structure marks
plotshape(showBos and evBos == 1, "BOS up", shape.triangleup, location.belowbar, cUp, size = size.tiny, text = "BOS")
plotshape(showBos and evBos == -1, "BOS down", shape.triangledown, location.abovebar, cDn, size = size.tiny, text = "BOS")

// ---------------------------------------------------------------- status table
var table tb = table.new(position.top_right, 2, 8, bgcolor = color.new(#1d1d1f, 10), border_width = 1, border_color = color.new(#3a3a3c, 0))
cell(int r, string k, string v, color c) =>
    table.cell(tb, 0, r, k, text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)
if showTbl and barstate.islast
    [e2, s2, t12, t22, r2] = calcLevels()
    cell(0, "Fib OTE", dir == 1 ? "buys only" : dir == -1 ? "sells only" : "no trend yet", dir == 1 ? cUp : dir == -1 ? cDn : color.gray)
    cell(1, "Status", st == 2 ? (hit1 ? "in trade · stop at entry" : "in trade") : st == 1 ? (r2 ? "limit working" : skipWhy()) : "waiting for an impulse", color.white)
    eS = st == 2 ? E : st == 1 ? e2 : float(na)
    sS = st == 2 ? stopNow : st == 1 ? s2 : float(na)
    cell(2, "Entry " + str.tostring(entryLvl), na(eS) ? "-" : fmt(eS), cGold)
    cell(3, "Stop", na(sS) ? "-" : fmt(sS), cDn)
    cell(4, "TP1 / TP2", st >= 1 ? fmt(st == 2 ? T1 : t12) + " / " + fmt(st == 2 ? T2 : t22) : "-", cTgt)
    rr = st >= 1 and not na(eS) and not na(sS) and math.abs(eS - sS) > 0 ? (math.abs((st == 2 ? T1 : t12) - eS) + math.abs((st == 2 ? T2 : t22) - eS)) / 2 / math.abs(eS - sS) : float(na)
    cell(5, "Half and half", na(rr) ? "-" : str.tostring(rr, "#.##") + "R", color.white)
    cell(6, "Wins / BE / losses", str.tostring(nWin) + " / " + str.tostring(nBE) + " / " + str.tostring(nLoss), color.white)
    cell(7, "No fill", str.tostring(nMiss), color.gray)

// ---------------------------------------------------------------- alerts
if evArm
    alert("Fib OTE: new impulse, " + (dir == 1 ? "buy" : "sell") + " limit at " + str.tostring(entryLvl) + " (" + syminfo.ticker + ")", alert.freq_once_per_bar_close)
if evFill
    alert("Fib OTE: filled " + (dir == 1 ? "long " : "short ") + fmt(E) + ", stop " + fmt(S) + " (" + syminfo.ticker + ")", alert.freq_once_per_bar_close)
if evT1
    alert("Fib OTE: TP1 " + fmt(T1) + ", take half, stop to entry (" + syminfo.ticker + ")", alert.freq_once_per_bar_close)
if evT2
    alert("Fib OTE: TP2 " + fmt(T2) + " (" + syminfo.ticker + ")", alert.freq_once_per_bar_close)
if evStop
    alert("Fib OTE: stopped (" + syminfo.ticker + ")", alert.freq_once_per_bar_close)
if evMiss
    alert("Fib OTE: no fill, new impulse (" + syminfo.ticker + ")", alert.freq_once_per_bar_close)
alertcondition(evFill, "Fib OTE filled", "Fib OTE: the limit in the OTE filled")
alertcondition(evT1, "Fib OTE TP1", "Fib OTE: TP1, take half, stop to entry")
alertcondition(evT2 or evStop, "Fib OTE trade done", "Fib OTE: trade done (TP2 or stop)")
