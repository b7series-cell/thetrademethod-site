//@version=6
// =====================================================================
// Heatmap Scalp, chart side — thetrademethod.com
// https://thetrademethod.com/setups/heatmap-scalp.html
//
// The video's trigger is read on a liquidity heatmap, which a chart
// script can't see. This marks the chart side of the setup, the same
// rules our test uses (ours where the video reads the heatmap):
//
// 1. Bias      Long when price is above the session VWAP and the last
//              two swing highs and swing lows are both rising (swings:
//              5 bars left, 2 right). Short is the mirror.
// 2. Location  A pullback bar that wicks into VWAP and closes back
//              above it, green (short: mirror). This is where you'd
//              watch the heatmap: do the sellers' big orders stop
//              working, does the bid hold?
// 3. Stop      Fixed: 0.08% of price by default (the video's 20 NQ
//              points at about 25,850). Size to it.
// 4. Target    A few ticks before the "wall", the high of day so far
//              (low of day for a short). Under 1R away: skipped.
//
// 9:45 to 15:30 New York, three a day at most. It marks and alerts.
// It does not place trades.
// =====================================================================
indicator("Heatmap Scalp chart side [TTM]", shorttitle = "HS bias [TTM]", overlay = true, max_lines_count = 300, max_labels_count = 300)

stopPct = input.float(0.08, "Fixed stop (% of price)", minval = 0.01, step = 0.01, tooltip = "The video risks a set dollar amount: about 20 NQ points in London. 0.08% of 25,850 is about 20 points.")
tickPad = input.int(2, "Exit this many ticks before the wall", minval = 0, maxval = 50)
pl = input.int(5, "Swing: bars left", minval = 1)
pr = input.int(2, "Swing: bars right", minval = 1)
maxTrades = input.int(3, "Trades a day at most", minval = 1, maxval = 10)
startMin = input.int(585, "Start (minutes after midnight NY)", tooltip = "585 = 9:45. Use 180 (3:00) to include London on futures.")
endMin = input.int(930, "Last entry (minutes after midnight NY)", tooltip = "930 = 15:30.")
cUp = input.color(#30d158, "Long")
cDn = input.color(#ff453a, "Short")

TZ = "America/New_York"
mod = hour(time, TZ) * 60 + minute(time, TZ)
vw = ta.vwap(hlc3)
ph = ta.pivothigh(high, pl, pr)
plo = ta.pivotlow(low, pl, pr)
var float h1 = na
var float h0 = na
var float l1 = na
var float l0 = na
if not na(ph)
    h0 := h1
    h1 := ph
if not na(plo)
    l0 := l1
    l1 := plo
up = h1 > h0 and l1 > l0
dn = h1 < h0 and l1 < l0
newDay = ta.change(time("D")) != 0
var float hod = na
var float lod = na
var int n = 0
var int side = 0
var float sl = na
var float tg = na
var float eP = na
hodPrev = hod
lodPrev = lod
if newDay
    hod := high
    lod := low
    n := 0
else
    hod := math.max(nz(hod, high), high)
    lod := math.min(nz(lod, low), low)

bool sigL = false
bool sigS = false
if side != 0
    bool out = side == 1 ? (low <= sl or high >= tg) : (high >= sl or low <= tg)
    if out or newDay
        side := 0
if side == 0 and n < maxTrades and mod >= startMin and mod <= endMin and not newDay and barstate.isconfirmed
    float risk = close * stopPct / 100
    if up and close[1] > vw[1] and low <= vw and close > vw and close > open
        float t = hodPrev - tickPad * syminfo.mintick
        if t - close >= risk
            sigL := true
            side := 1
            eP := close
            sl := close - risk
            tg := t
    else if dn and close[1] < vw[1] and high >= vw and close < vw and close < open
        float t = lodPrev + tickPad * syminfo.mintick
        if close - t >= risk
            sigS := true
            side := -1
            eP := close
            sl := close + risk
            tg := t
    if sigL or sigS
        n += 1
        color cc = sigL ? cUp : cDn
        label.new(bar_index, sigL ? low : high, (sigL ? "LONG " : "SHORT ") + str.tostring(close, format.mintick) + "\nwatch the book", style = sigL ? label.style_label_up : label.style_label_down, color = cc, textcolor = color.white, size = size.small)
        line.new(bar_index, sl, bar_index + 15, sl, color = cDn, style = line.style_dashed)
        line.new(bar_index, tg, bar_index + 15, tg, color = cUp, style = line.style_dashed)

plot(vw, "Session VWAP", color = color.new(#2997ff, 0), linewidth = 2)
bgcolor(up and close > vw ? color.new(cUp, 94) : dn and close < vw ? color.new(cDn, 94) : na, title = "Bias")
alertcondition(sigL, "HS long", "Heatmap Scalp: long pullback into VWAP. Check the heatmap before you click.")
alertcondition(sigS, "HS short", "Heatmap Scalp: short pullback into VWAP. Check the heatmap before you click.")
