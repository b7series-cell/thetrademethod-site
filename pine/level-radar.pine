//@version=6
// Level Radar [GBB]

indicator("Level Radar [GBB]", "LevelRadar", overlay = true, max_lines_count = 50, max_labels_count = 50, max_boxes_count = 50)

// ---------------------------------------------------------------- inputs
grpW = "Session"
sessSel  = input.string("Auto", "Session", options = ["Auto", "Full day", "Custom"], group = grpW,
     tooltip = "The odds run to the end of this window. Auto: stocks use the regular session, US equity index futures 09:30 to 16:00 New York, everything else the full trading day.")
custSess = input.session("0820-1330", "Custom session", group = grpW,
     tooltip = "Used with Session = Custom. Start it on a bar boundary of the chart's timeframe.")
custTz   = input.string("America/New_York", "Custom time zone", group = grpW)

grpL = "Levels"
onPdh = input.bool(true, "PDH", group = grpL, inline = "l1", tooltip = "High, low and close of the previous session.")
onPdl = input.bool(true, "PDL", group = grpL, inline = "l1")
onPdc = input.bool(true, "PDC", group = grpL, inline = "l1")
onOnh = input.bool(true, "ONH", group = grpL, inline = "l2", tooltip = "High and low of the bars between the previous session and this one. Empty on full-day sessions and on charts without extended hours.")
onOnl = input.bool(true, "ONL", group = grpL, inline = "l2")
onOpn = input.bool(true, "OPEN", group = grpL, inline = "l2")
onOrh = input.bool(true, "ORH", group = grpL, inline = "l3", tooltip = "High and low of the opening range. They exist once the opening range is over.")
onOrl = input.bool(true, "ORL", group = grpL, inline = "l3")
onHod = input.bool(true, "HOD", group = grpL, inline = "l4", tooltip = "Today's high and low so far. The odds are the chance of a new high or low before the session ends.")
onLod = input.bool(true, "LOD", group = grpL, inline = "l4")
orMin = input.int(30, "Opening range (minutes)", minval = 1, group = grpL)

grpD = "Display"
showLines = input.bool(true, "Level lines with odds", group = grpD, inline = "ln",
     tooltip = "Each line is labelled with the chance that price touches it before the session ends. Brighter means more likely. A tick mark means it was already touched today; the odds are then the chance of another touch.")
extBars   = input.int(12, "bars to the right", minval = 2, maxval = 100, group = grpD, inline = "ln")
lblSize   = input.string("Normal", "Label size", options = ["Small", "Normal", "Large"], group = grpD)
panelSel  = input.string("Top right", "Panel", options = ["Top right", "Middle right", "Bottom right", "Top center", "Bottom center", "Top left", "Middle left", "Bottom left", "Off"], group = grpD,
     tooltip = "Time left, today's range against the usual range, and the levels ranked by odds.")
panelSize = input.string("Normal", "Panel size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = grpD,
     tooltip = "Text and meter size of the panel, independent of the label size.")
boardSel  = input.string("Compact", "Scoreboard", options = ["Compact", "Full", "Off"], group = grpD,
     tooltip = "Keeps score on this chart. For each named level, one forecast per session is scored (at the open; opening-range levels when the range is over): the average forecast against the share that was touched. In a 15-year study on index futures and gold, named levels were touched as often as any other price at the same distance.")
showPast  = input.bool(false, "Levels of past sessions", group = grpD)
shadeOn   = input.bool(true, "Shade the session", group = grpD)

grpS = "Style"
themeSel = input.string("Neon", "Theme", options = ["Neon", "Classic", "Custom"], group = grpS,
     tooltip = "Neon and Classic set the colours; Custom uses the three below.")
upIn  = input.color(#00e5b4, "Above price", group = grpS, inline = "cu")
dnIn  = input.color(#ff4d6d, "Below price", group = grpS, inline = "cu")
accIn = input.color(#ffb21e, "Accent", group = grpS, inline = "cu")
color upCol  = themeSel == "Neon" ? #00e5b4 : themeSel == "Classic" ? #26a69a : upIn
color dnCol  = themeSel == "Neon" ? #ff4d6d : themeSel == "Classic" ? #ef5350 : dnIn
color accCol = themeSel == "Neon" ? #ffb21e : themeSel == "Classic" ? #f5b041 : accIn

glowSel  = input.string("Strong", "Glow", options = ["Strong", "Soft", "Off"], group = grpS,
     tooltip = "Halo and zone around each level, scaled by its odds. Strong: three layers and a zone. Soft: one thin halo.")
dimBars  = input.bool(true, "Dim candles", group = grpS, tooltip = "Greys the bars so the levels stand out. Turn off to keep your chart's colours.")
showPrice = input.bool(true, "Price in labels", group = grpS)

grpA = "Alerts (on bar close; create one alert with 'Any alert() function call')"
alTouch = input.bool(true, "A level was touched", group = grpA)
alOdds  = input.bool(false, "A level's odds rose above", group = grpA, inline = "odds")
alThr   = input.float(65.0, "%", minval = 1, maxval = 99, group = grpA, inline = "odds")

// ---------------------------------------------------------------- constants
var string[] US_IDX = array.from("ES", "NQ", "YM", "RTY", "MES", "MNQ", "MYM", "M2K")
bool  IS_US_IDX = syminfo.type == "futures" and US_IDX.includes(syminfo.root)
bool  IS_STOCK  = syminfo.type == "stock" or syminfo.type == "fund" or syminfo.type == "index" or syminfo.type == "dr"
// 0 = full trading day, 1 = session string, 2 = the exchange's regular session
int   MODE = sessSel == "Custom" ? 1 : sessSel == "Full day" ? 0 : IS_US_IDX ? 1 : IS_STOCK ? 2 : 0
string SESS = sessSel == "Custom" ? custSess : "0930-1600"
string TZ   = sessSel == "Custom" ? custTz : "America/New_York"
float TF    = timeframe.in_seconds() / 60.0                  // bar length in minutes
bool  TF_OK = timeframe.isintraday and timeframe.in_seconds() >= 60 and timeframe.in_seconds() <= 3600
int   LEN_N = 5                                              // window length = most common of the last 5 completed windows
// odds model
bool  DAY   = MODE == 0             // full-day windows: time-of-day scale, pooled table, random-walk law
int   NB    = 60                    // bins of width BW, plus one overflow bin
float BW    = 0.05
float C_RW  = 1.596                 // expected range of a random walk over a window / its standard deviation
int   W_TAB = 20                    // completed windows behind the tables
int   RBAR_N = 10
int   RBAR_MIN = 3
int   PROF_N = 60                   // windows behind the time-of-day profile
int   SLOT   = 30                   // minutes per profile slot
int   NSLOT_MAX = 48
int   NBK   = DAY ? 1 : 16          // time buckets per window
int   ROWS  = NBK * 2               // bucket and direction (0 = up, 1 = down)
int   RLEN  = ROWS * (NB + 1)
float M1    = 80.0                  // session windows: weight of the bucket table is n / (n + M1)
float M2    = 80.0                  // full-day windows: weight of the pooled table is n / (n + M2)

// ---------------------------------------------------------------- helpers
// Most common value; ties go to the most recent one.
modeRecent(array<float> a) =>
    float best = na
    int bestN = 0
    for i = a.size() - 1 to 0
        float v = a.get(i)
        int n = 0
        for j = 0 to a.size() - 1
            if a.get(j) == v
                n += 1
        if n > bestN
            bestN := n
            best := v
    best

// tail[r * (NB + 2) + k] = sum of row r's bins k .. NB; one extra 0 closes each row.
tails(array<float> hist, int nrow) =>
    array<float> t = array.new<float>(nrow * (NB + 2), 0.0)
    for r = 0 to nrow - 1
        float acc = 0.0
        for k = NB to 0
            acc += hist.get(r * (NB + 1) + k)
            t.set(r * (NB + 2) + k, acc)
    t

// Share of samples >= x in row r, linear inside a bin; na when the row is empty.
surv(array<float> hist, array<float> tail, int r, float x) =>
    float n = tail.get(r * (NB + 2))
    float res = na
    if n > 0
        float q = math.min(x / BW, NB + 1.0)
        int k = math.min(int(math.floor(q)), NB)
        float frac = k < NB ? q - k : 0.0
        res := (tail.get(r * (NB + 2) + k + 1) + (1.0 - frac) * hist.get(r * (NB + 1) + k)) / n
    res

// Random-walk law 2 * (1 - Phi(C_RW * x)), Abramowitz-Stegun 7.1.26.
s0(float x) =>
    float u = C_RW * x / math.sqrt(2.0)
    float k = 1.0 / (1.0 + 0.3275911 * u)
    float poly = k * (0.254829592 + k * (-0.284496736 + k * (1.421413741 + k * (-1.453152027 + k * 1.061405429))))
    poly * math.exp(-u * u)

// Long-run curve for session windows: remaining excursion in model units, 16 time buckets x 61 bins,
// ES, NQ, YM (09:30 to 16:00) and GC (08:20 to 13:30), 5-minute bars, 2011 to 2026.
curveInit() =>
    array<string> rows = array.from(
         "16441,14922,14283,13672,12674,11495,10132,8792,7625,6695,5589,4668,3920,3425,2878,2464,1970,1684,1470,1257,1037,871,767,656,570,497,362,377,295,259,251,199,197,189,140,150,115,92,80,84,79,67,67,48,48,45,51,40,35,38,28,33,28,21,20,18,16,8,19,8,127",
