         "11821,11873,11834,11581,10843,10111,9306,8358,7294,6650,5973,5229,4623,4171,3594,3196,2685,2461,2140,1834,1628,1471,1302,1140,994,830,748,698,544,550,475,418,375,326,287,247,228,205,186,189,152,121,146,98,104,79,69,70,60,63,59,53,51,46,44,45,46,30,43,29,330",
