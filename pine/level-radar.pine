         "15691,14931,13720,12779,12119,10829,9547,8540,7356,6515,5660,4805,4269,3560,3216,2775,2392,1999,1794,1535,1340,1058,973,841,705,597,448,407,362,310,287,248,220,194,154,151,147,126,108,77,80,68,56,71,60,51,59,52,39,39,32,29,28,33,23,27,34,18,25,16,261",
         "15309,14746,14150,13144,11889,10814,9611,8603,7368,6410,5683,4908,4223,3685,3131,2635,2254,1926,1610,1466,1296,1072,983,857,728,653,501,414,372,289,287,230,175,170,177,151,137,119,113,105,105,74,81,62,42,40,53,41,41,41,36,38,20,27,32,19,31,20,19,16,292",
         "14591,14750,13965,13202,11806,10790,9827,8669,7603,6502,5647,4789,4320,3583,3019,2653,2283,1946,1673,1505,1323,1173,927,866,810,665,538,456,373,293,290,239,219,188,176,168,143,117,128,94,90,78,74,77,79,52,56,39,44,47,41,38,33,40,30,21,16,8,12,11,327",
         "11545,11345,11028,10192,9261,8505,7455,6499,6042,5167,4574,3988,3359,2898,2478,2104,1844,1729,1392,1200,1106,889,794,701,598,528,422,405,352,280,253,192,176,182,157,135,98,105,94,79,86,70,60,65,47,42,44,40,31,36,36,42,36,30,23,25,24,19,13,23,267",
         "14235,13744,13355,12775,11505,10504,9344,8250,7463,6625,5689,5096,4380,3748,3207,2712,2346,1995,1794,1559,1434,1189,1058,927,783,723,629,520,462,436,404,319,268,235,174,185,143,143,149,108,99,101,96,66,70,69,50,51,52,66,54,44,43,37,38,28,29,35,18,23,410",
         "13512,13029,12915,12360,11353,10227,9213,8146,7275,6578,5827,5170,4405,3749,3199,2819,2411,2101,1717,1655,1416,1234,1070,939,853,713,655,560,486,466,434,391,333,275,199,204,165,176,142,147,126,118,82,99,71,76,65,72,61,40,44,48,46,48,47,37,29,31,29,25,445",
