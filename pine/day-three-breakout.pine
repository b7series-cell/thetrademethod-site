//@version=6
// Day Three Breakout — The Trade Method
// thetrademethod.com/setups/day-three-breakout.html
//
// The page's rules made objective (the same rules as the page's example chart, js/d3b-live.js):
// DAILY (closed days only)
//   Day one   the close is 20%+ above the prior close on 3x+ the 20-day average volume. The script can't read the
//             news, so it can't check for a catalyst. That part is on you.
//   Day two   an inside day on lower volume: high <= day one's high, low >= day one's low, volume < day one's,
//             and it doesn't open in the lower half of day one's range.
//   Day three the next session. The buy stop sits at the day-two high.
// DAY THREE, intraday (built for the 5-minute chart, regular hours)
//   Entry     the first bar that trades above the day-two high, if that bar starts before 10:00 ET (every example in
//             the video broke in the first 30 minutes). Fill at the day-two high, or at the open if it opened above.
//             A later break is marked and skipped (wait for a pullback rather than chase).
//   Stop      a few cents under the breakout bar's low: 1% of the entry, at least 0.01 and at most 0.05.
//             Low of day is the video's wider alternative (a setting).
//   Exits     a third into blow-off volume (the first close above the entry on 1.5x+ the average volume of the
//             session's earlier bars); a third at the next whole dollar after a VWAP dip holds; the rest on the
//             first close below the 9 EMA, or at the session close. The stop is always checked first.
//             The video sells a third or a quarter at a time; the thirds and these triggers are our objective version.
// Within a bar, the stop is checked before any exit.
indicator("Day Three Breakout — The Trade Method", shorttitle="D3B", overlay=true, max_labels_count=300, max_lines_count=300)

// ---------- inputs ----------
gD = "Day one and day two"
minGain  = input.float(20.0, "Day one: close up at least (%)", minval=1, step=1, group=gD)
minVolX  = input.float(3.0, "Day one: volume at least (x 20-day average)", minval=1, step=0.5, group=gD)
useOpen  = input.bool(true, "Day two must open in the upper half of day one's range", group=gD)
minPrice = input.float(1.0, "Skip stocks under ($)", minval=0, step=0.5, group=gD)
gT = "Day three"
lastMin  = input.int(30, "Entry only if the break starts within (minutes of the open)", minval=5, maxval=390, group=gT)
stopMode = input.string("A few cents under the breakout bar", "Stop", options=["A few cents under the breakout bar", "Low of day"], group=gT)
blowX    = input.float(1.5, "Blow-off volume (x the session's average bar)", minval=1, step=0.1, group=gT)
emaLen   = input.int(9, "Trail EMA length", minval=2, group=gT)
gV = "Display"
showLvl  = input.bool(true, "Draw the buy stop, stop and exits", group=gV)
showPan  = input.bool(true, "Status panel", group=gV)
colBuy   = input.color(#2997ff, "Buy stop / entry", group=gV)
colStop  = input.color(#ff453a, "Stop", group=gV)
colExit  = input.color(#30d158, "Exits", group=gV)
colEma   = input.color(#f4b942, "9 EMA", group=gV)
colVwap  = input.color(#64d2ff, "VWAP", group=gV)

// ---------- daily data: [1] = yesterday (day two), [2] = day one, all closed ----------
[dO1, dH1, dL1, dV1, dO2, dH2, dL2, dC2, dV2, dC3, dVA] = request.security(syminfo.tickerid, "D",
     [open[1], high[1], low[1], volume[1], open[2], high[2], low[2], close[2], volume[2], close[3], ta.sma(volume, 20)[3]],
     lookahead=barmerge.lookahead_on)
gain   = dC3 > 0 ? dC2 / dC3 - 1 : na
volX   = dVA > 0 ? dV2 / dVA : na
isD1   = gain >= minGain / 100 and volX >= minVolX and dC2 >= minPrice
isD2   = dH1 <= dH2 and dL1 >= dL2 and dV1 < dV2 and (not useOpen or dO1 >= (dH2 + dL2) / 2)
armedDay = isD1 and isD2
d2h    = dH1

// ---------- intraday series ----------
intra  = timeframe.isintraday
mins   = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
rth    = mins >= 570 and mins < 960
newDay = ta.change(time("D")) != 0
emaV   = ta.ema(close, emaLen)
var float pv = 0.0
var float vv = 0.0
var bool  sessStarted = false
if newDay
    sessStarted := false
if rth and not sessStarted
    pv := 0.0
    vv := 0.0
    sessStarted := true
if rth
    pv += hlc3 * volume
    vv += volume
vwapR = vv > 0 ? pv / vv : na
lastBar = rth and (mins + timeframe.multiplier >= 960)

// ---------- state ----------
var bool  inTr = false
var bool  late = false
var bool  dayDone = false
var float E = na
var float SL = na
var float risk = na
var float rem = 0.0
var float sumPx = 0.0
var bool  p1 = false
var bool  p2 = false
var float wd = na
var float lod = na
var float sVol = 0.0
var int   sCnt = 0
var int   entryBar = na
var line  lnBuy = na
var line  lnStop = na
var int   nTr = 0
var float sumR = 0.0
var float lastR = na
var string state = "Watching"

bool armNow = false
bool entryNow = false
bool exitNow = false
string exitWhy = ""

r2(x) => math.round(x * 100) / 100

f_part(float frac, float px, string why) =>
    label.new(bar_index, px, why, style=label.style_label_left, color=color.new(why == "stop" ? colStop : colExit, 25), textcolor=color.white, size=size.tiny)
    frac * (px - E)

if intra and newDay
    // a new session: reset, then see if today is a day three
    late := false
    dayDone := false
    lod := na
    sVol := 0.0
    sCnt := 0
    if armedDay and not inTr
        armNow := true
        state := "Armed · buy stop " + str.tostring(d2h, format.mintick)
        if showLvl
            lnBuy := line.new(bar_index, d2h, bar_index + 1, d2h, color=colBuy, style=line.style_dashed, width=2)
    else if not inTr
        state := "Watching"

if intra and rth and armedDay
    lod := na(lod) ? low : math.min(lod, low)
    if showLvl and not na(lnBuy) and not inTr and not dayDone and not late
        line.set_x2(lnBuy, bar_index)
    // entry
    if not inTr and not late and not dayDone
        if high > d2h
            if mins < 570 + lastMin
                E := math.max(d2h, open)
                off = math.min(0.05, math.max(0.01, r2(E * 0.01)))
                SL := stopMode == "Low of day" ? r2(lod - off) : r2(low - off)
                risk := E - SL
                inTr := true
                entryNow := true
                entryBar := bar_index
                rem := 1.0
                sumPx := 0.0
                p1 := false
                p2 := false
                wd := na
                state := "In trade · entry " + str.tostring(E, format.mintick) + " · stop " + str.tostring(SL, format.mintick)
                if showLvl
                    lnStop := line.new(bar_index, SL, bar_index + 1, SL, color=colStop, style=line.style_dashed, width=2)
                    label.new(bar_index, E, "Buy " + str.tostring(E, format.mintick), style=label.style_label_up, yloc=yloc.belowbar, color=colBuy, textcolor=color.white, size=size.small)
            else
                late := true
                state := "Broke after the first " + str.tostring(lastMin) + " minutes · skipped"
                if showLvl
                    label.new(bar_index, high, "late break", style=label.style_label_down, color=color.new(#8e8e93, 30), textcolor=color.white, size=size.tiny)
    // manage, from the bar after the entry
    else if inTr and bar_index > entryBar
        if showLvl
            line.set_x2(lnStop, bar_index)
        if low <= SL
            sumPx += f_part(rem, math.min(open, SL), "stop")
            rem := 0.0
            exitWhy := "stop"
        else
            avgV = sCnt > 0 ? sVol / sCnt : na
            if not p1 and not na(avgV) and close > E and volume >= blowX * avgV
                sumPx += f_part(1.0 / 3, close, "⅓ blow-off")
                rem -= 1.0 / 3
                p1 := true
            if not p2 and rem > 1e-6
                if not na(wd) and high >= wd
                    sumPx += f_part(1.0 / 3, wd, "⅓ " + str.tostring(wd, "#"))
                    rem -= 1.0 / 3
                    p2 := true
                else if na(wd) and low <= vwapR and close > vwapR
                    wd := math.max(math.floor(close) + 1, math.floor(E) + 1)
            if rem > 1e-6 and close < emaV
                sumPx += f_part(rem, close, "9 EMA close")
                rem := 0.0
                exitWhy := "9 EMA"
        if rem > 1e-6 and lastBar
            sumPx += f_part(rem, close, "close")
            rem := 0.0
            exitWhy := "session close"
        if rem <= 1e-6
            lastR := risk > 0 ? sumPx / risk : 0.0
            nTr += 1
            sumR += lastR
            inTr := false
            dayDone := true
            exitNow := true
            state := "Done · " + (lastR >= 0 ? "+" : "") + str.tostring(lastR, "#.##") + "R (" + exitWhy + ")"
            label.new(bar_index, high, (lastR >= 0 ? "+" : "") + str.tostring(lastR, "#.#") + "R", style=label.style_label_down, color=color.new(lastR >= 0 ? colExit : colStop, 10), textcolor=color.white, size=size.small)
    if rth
        sVol += volume
        sCnt += 1

if intra and inTr and not rth and newDay
    // safety: a trade never carries overnight (shouldn't happen, the session close exits it)
    inTr := false

// ---------- plots ----------
plot(intra ? emaV : na, "9 EMA", color=colEma, linewidth=2)
plot(intra and rth ? vwapR : na, "VWAP", color=colVwap, linewidth=1, style=plot.style_linebr)
// on a daily chart: mark day three (the bar after a qualifying day two)
plotshape(timeframe.isdaily and armedDay, "Day three (buy stop at the day-two high)", shape.triangleup, location.belowbar, colBuy, size=size.small)

// ---------- panel ----------
var table pan = table.new(position.top_right, 2, 5, bgcolor=color.new(#000000, 15), border_width=1, border_color=color.new(#808080, 60))
if barstate.islast and showPan
    table.cell(pan, 0, 0, "D3B", text_color=colBuy, text_size=size.small)
    table.cell(pan, 1, 0, intra ? state : (armedDay ? "Today is a day three · buy stop " + str.tostring(d2h, format.mintick) : "Use a 5-minute chart to trade it"), text_color=#f5f5f7, text_size=size.small)
    table.cell(pan, 0, 1, "Day one", text_color=#a1a1a6, text_size=size.small)
    table.cell(pan, 1, 1, na(gain) ? "—" : str.tostring(gain * 100, "#") + "% on " + str.tostring(volX, "#.#") + "x volume (2 days ago)", text_color=isD1 ? #30d158 : #a1a1a6, text_size=size.small)
    table.cell(pan, 0, 2, "Day two", text_color=#a1a1a6, text_size=size.small)
    table.cell(pan, 1, 2, isD2 ? "inside day on lower volume" : "not an inside day on lower volume", text_color=isD2 ? #30d158 : #a1a1a6, text_size=size.small)
    table.cell(pan, 0, 3, "Trades on chart", text_color=#a1a1a6, text_size=size.small)
    table.cell(pan, 1, 3, str.tostring(nTr) + (nTr > 0 ? " · avg " + str.tostring(sumR / nTr, "#.##") + "R" : ""), text_color=#f5f5f7, text_size=size.small)
    table.cell(pan, 0, 4, "Chart", text_color=#a1a1a6, text_size=size.small)
    table.cell(pan, 1, 4, intra and timeframe.multiplier == 5 ? "5-minute" : timeframe.period + " (built for 5-minute)", text_color=intra and timeframe.multiplier == 5 ? #f5f5f7 : #ff9f0a, text_size=size.small)

// ---------- alerts ----------
alertcondition(armNow, "Armed — day three, buy stop at the day-two high", "D3B armed on {{ticker}}: today is a day three. Buy stop at the day-two high.")
alertcondition(entryNow, "Entry — broke the day-two high", "D3B entry on {{ticker}} @ {{close}}")
alertcondition(exitNow, "Exit — trade closed", "D3B exit on {{ticker}} @ {{close}}")
if armNow
    alert('{"event":"armed","ticker":"' + syminfo.ticker + '","buy_stop":' + str.tostring(d2h, format.mintick) + '}', alert.freq_once_per_bar_close)
if entryNow
    alert('{"event":"entry","ticker":"' + syminfo.ticker + '","entry":' + str.tostring(E, format.mintick) + ',"stop":' + str.tostring(SL, format.mintick) + '}', alert.freq_once_per_bar_close)
if exitNow
    alert('{"event":"exit","ticker":"' + syminfo.ticker + '","why":"' + exitWhy + '","r":' + str.tostring(lastR, "#.##") + '}', alert.freq_once_per_bar_close)
