//@version=6
indicator("ICT Made Simple · The Trade Method", "ICT Simple", overlay = true, max_boxes_count = 200, max_lines_count = 300, max_labels_count = 300, max_bars_back = 1000)

// Built from thetrademethod.com/setups/ict-made-simple.html
// HTF maps the trade (trend, structure, range, POIs). The chart time frame times the entry
// (low taken -> close through the high = MSS -> enter on that close, the video's way;
// a stopped trade counts as a new low taken). Defaults are the video's numbers.
// HTF data is read from closed HTF candles only, so nothing here repaints.

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
string ZOOM     = "Zoomed in (LTF breaker)"
string HTFONLY  = "HTF only (limit at POI)"
string RETEST   = "Breaker retest"
string MSSCLOSE = "MSS close"

string G1 = "1 · Trend and structure (high time frame)"
string htfMode    = input.string("Auto", "High time frame", options = ["Auto", "Manual"], group = G1, tooltip = "Auto uses the page's pairs: 5m chart -> 1H, 15m -> 4H, 1H/4H -> Daily, Daily -> Weekly, Weekly -> Monthly.")
string htfManual  = input.timeframe("60", "Manual HTF", group = G1)
int    htfL       = input.int(1, "HTF swing strength (candles each side)", minval = 1, maxval = 10, group = G1, tooltip = "The video: a swing is three candles, one lower (higher) candle on each side, so 1. Raise it to keep only the more obvious swings.")
bool   showStruct = input.bool(true, "Show MSB / MSS labels", group = G1)

string G2 = "2 · Range, premium and discount"
bool showRange = input.bool(true, "Show range high, low and 0.5", group = G2)
bool showOte   = input.bool(true, "Show OTE zone (0.618 to 0.786)", group = G2)

string G3 = "3 · Points of interest"
bool  showFvg     = input.bool(true, "Fair value gaps", group = G3)
bool  showOb      = input.bool(true, "Order blocks", group = G3)
bool  showBrk     = input.bool(true, "Breaker blocks", group = G3)
float fvgMinAtr   = input.float(0.0, "Minimum FVG size (x HTF ATR)", minval = 0.0, step = 0.05, group = G3, tooltip = "The video takes any gap (0). A minimum is our filter.")
int   maxPoi      = input.int(12, "Maximum POIs kept on chart", minval = 3, maxval = 40, group = G3)
bool  poiNeedZone = input.bool(true, "Only trade POIs in discount (longs) / premium (shorts)", group = G3)
color colBull     = input.color(#2ecf7a, "Bullish", group = G3)
color colBear     = input.color(#e0505a, "Bearish", group = G3)
color colBrk      = input.color(#f4b942, "Breaker", group = G3)

string G4 = "4 · Entry"
string entryMethod = input.string(ZOOM, "Entry method", options = [ZOOM, HTFONLY], group = G4)
string tradeDir    = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = G4)
int    ltfL        = input.int(1, "LTF swing strength", minval = 1, maxval = 10, group = G4)
string ltfEntry    = input.string(MSSCLOSE, "LTF entry price", options = [RETEST, MSSCLOSE], group = G4, tooltip = "Breaker retest waits for price to come back to the breaker. MSS close enters on the candle that closes through the high (low for shorts).")
int    armBars     = input.int(60, "Bars to wait for the LTF flip after a POI tag", minval = 5, group = G4)
int    retestBars  = input.int(20, "Bars to wait for the breaker retest", minval = 1, group = G4)

string G5 = "5 · Stop, target and size"
float minRR    = input.float(1.5, "Minimum reward-to-risk to external liquidity", minval = 0.0, step = 0.1, group = G5)
float stopBuf  = input.float(0.0, "Stop buffer (x ATR)", minval = 0.0, step = 0.05, group = G5, tooltip = "The video: the stop goes at the low before the reversal (high for shorts), so 0. A buffer is ours.")
float riskUsd  = input.float(100.0, "Dollar risk per trade (for share size)", minval = 1.0, group = G5)

string G6 = "6 · Display"
bool   showTrades = input.bool(true, "Show entry, stop and target lines", group = G6)
bool   showTable  = input.bool(true, "Show pre-trade checklist", group = G6)
string tablePos   = input.string("Top right", "Checklist position", options = ["Top right", "Bottom right", "Bottom left", "Top left"], group = G6)

string G7 = "7 · Alerts"
bool alEntry  = input.bool(true, "Entry alerts", group = G7)
bool alSetup  = input.bool(true, "LTF MSS (setup) alerts", group = G7)
bool alTag    = input.bool(false, "POI tagged alerts", group = G7)
bool alStruct = input.bool(false, "HTF MSB / MSS alerts", group = G7)
bool alExit   = input.bool(true, "Target / stop alerts", group = G7)

// ─────────────────────────────────────────────────────────────────────────────
// High time frame data (closed candles only)
// ─────────────────────────────────────────────────────────────────────────────
f_autoHtf() =>
    int s = timeframe.in_seconds()
    string r = switch
        s <= 300   => "60"
        s <= 900   => "240"
        s <= 14400 => "D"
        s <= 86400 => "W"
        => "M"
    r

string htf = htfMode == "Auto" ? f_autoHtf() : htfManual
if timeframe.in_seconds(htf) <= timeframe.in_seconds()
    runtime.error("ICT Made Simple: the high time frame (" + htf + ") must be higher than the chart time frame.")

[hO, hH, hL, hC, hT] = request.security(syminfo.tickerid, htf, [open[1], high[1], low[1], close[1], time[1]], lookahead = barmerge.lookahead_on)
bool newHtf = not na(hT) and (na(hT[1]) or hT != hT[1])

// ─────────────────────────────────────────────────────────────────────────────
// POI objects
// ─────────────────────────────────────────────────────────────────────────────
type POI
    float  top
    float  bot
    int    t0
    int    dir
    string kind
    box    bx
    bool   used = false

var array<POI> pois = array.new<POI>()

f_style(POI p) =>
    color c = switch
        p.kind == "BRK" => colBrk
        p.dir == 1      => colBull
        => colBear
    p.bx.set_bgcolor(color.new(c, p.used ? 93 : 84))
    p.bx.set_border_color(color.new(c, p.used ? 75 : 45))
    p.bx.set_text((p.dir == 1 ? "+" : "−") + p.kind)
    p.bx.set_text_color(color.new(c, 25))

f_addPoi(float top, float bot, int t0, int dir, string kind) =>
    bool show = switch kind
        "FVG" => showFvg
        "OB"  => showOb
        => showBrk
    if show and top > bot
        box b = box.new(t0, top, time, bot, xloc = xloc.bar_time, extend = extend.right, text_size = size.small, text_halign = text.align_right, text_valign = text.align_center, border_width = 1)
        POI p = POI.new(top, bot, t0, dir, kind, b)
        f_style(p)
        pois.push(p)
        if pois.size() > maxPoi
            POI old = pois.shift()
            old.bx.delete()

// An order block that price closes through flips into a breaker. Anything else that fails is removed.
f_maintain(float c) =>
    int i = pois.size() - 1
    while i >= 0
        POI p = pois.get(i)
        bool brokeDn = p.dir == 1 and c < p.bot
        bool brokeUp = p.dir == -1 and c > p.top
        if brokeDn or brokeUp
            if p.kind == "OB" and showBrk
                p.kind := "BRK"
                p.dir  := -p.dir
                p.used := false
                f_style(p)
            else
                p.bx.delete()
                pois.remove(i)
        i -= 1

// ─────────────────────────────────────────────────────────────────────────────
// HTF engine: swings, MSB / MSS, range, POIs
// ─────────────────────────────────────────────────────────────────────────────
var array<float> aO = array.new<float>()
var array<float> aH = array.new<float>()
var array<float> aL = array.new<float>()
var array<float> aC = array.new<float>()
var array<int>   aT = array.new<int>()

var float hAtr  = na
var int   trend = 0
var float shP = na
var int   shI = na
var bool  shBroken = true
var float slP = na
var int   slI = na
var bool  slBroken = true
var int   lastUpBrkI = 0
var int   lastDnBrkI = 0
var float rHi = na
var float rLo = na
var int   rHiI = na
var int   rLoI = na

f_pivH(int p, int L) =>
    bool ok = true
    float v = aH.get(p)
    for i = 1 to L
        if aH.get(p - i) > v or aH.get(p + i) >= v
            ok := false
            break
    ok

f_pivL(int p, int L) =>
    bool ok = true
    float v = aL.get(p)
    for i = 1 to L
        if aL.get(p - i) < v or aL.get(p + i) <= v
            ok := false
            break
    ok

f_lowestIdx(int a, int b) =>
    int r = a
    for i = a to b
        if aL.get(i) < aL.get(r)
            r := i
    r

f_highestIdx(int a, int b) =>
    int r = a
    for i = a to b
        if aH.get(i) > aH.get(r)
            r := i
    r

// Bullish OB: the down candle(s) before the up move. Bearish OB: the up candle(s) before the down move.
f_obAt(int iStart, int dir) =>
    int k = iStart
    int tries = 0
    while k > 0 and tries < 5 and (dir == 1 ? aC.get(k) >= aO.get(k) : aC.get(k) <= aO.get(k))
        k -= 1
        tries += 1
    bool ok = dir == 1 ? aC.get(k) < aO.get(k) : aC.get(k) > aO.get(k)
    if ok
        float zt = aH.get(k)
        float zb = aL.get(k)
        int j = k - 1
        int m = 0
        while j >= 0 and m < 2 and (dir == 1 ? aC.get(j) < aO.get(j) : aC.get(j) > aO.get(j))
            zt := math.max(zt, aH.get(j))
            zb := math.min(zb, aL.get(j))
            j -= 1
            m += 1
        f_addPoi(zt, zb, aT.get(j + 1), dir, "OB")

f_structLabel(string txt, float lvl, int tSwing, bool up) =>
    if showStruct
        line.new(tSwing, lvl, time, lvl, xloc = xloc.bar_time, color = color.new(up ? colBull : colBear, 30), style = line.style_dashed)
        label.new(time, lvl, txt, xloc = xloc.bar_time, style = up ? label.style_label_lower_right : label.style_label_upper_right, color = color.new(#000000, 100), textcolor = up ? colBull : colBear, size = size.small)

bool evMsbUp = false
bool evMssUp = false
bool evMsbDn = false
bool evMssDn = false

if newHtf
    aO.push(hO)
    aH.push(hH)
    aL.push(hL)
    aC.push(hC)
    aT.push(hT)
    int n = aC.size() - 1

    if n >= 1
        float pc = aC.get(n - 1)
        float tr = math.max(hH - hL, math.abs(hH - pc), math.abs(hL - pc))
        hAtr := na(hAtr) ? tr : (hAtr * 13 + tr) / 14

    // Confirmed swings
    int p = n - htfL
    if p - htfL >= 0
        if f_pivH(p, htfL) and p >= lastUpBrkI
            float v = aH.get(p)
            if shBroken or na(shP) or v > shP
                shP := v
                shI := p
                shBroken := false
        if f_pivL(p, htfL) and p >= lastDnBrkI
            float v = aL.get(p)
            if slBroken or na(slP) or v < slP
                slP := v
                slI := p
                slBroken := false

    // POIs that failed on this close
    f_maintain(hC)

    // Structure. Bodies only: a wick through a level does not count.
    bool upMSB = trend >= 0 and not shBroken and not na(shP) and hC > shP
    bool dnMSS = trend == 1 and not na(rLo) and hC < rLo
    bool dnMSB = trend <= 0 and not slBroken and not na(slP) and hC < slP
    bool upMSS = trend == -1 and not na(rHi) and hC > rHi

    if upMSB
        int iLow = f_lowestIdx(shI, n)
        f_structLabel("MSB", shP, aT.get(shI), true)
        rLo := aL.get(iLow)
        rLoI := iLow
        rHi := hH
        rHiI := n
        shBroken := true
        lastUpBrkI := n
        trend := 1
        evMsbUp := true
        f_obAt(iLow, 1)
    else if upMSS
        f_structLabel("MSS", rHi, aT.get(rHiI), true)
        rHi := hH
        rHiI := n
        shBroken := true
        lastUpBrkI := n
        trend := 1
        evMssUp := true
        f_obAt(rLoI, 1)
    else if dnMSB
        int iHigh = f_highestIdx(slI, n)
        f_structLabel("MSB", slP, aT.get(slI), false)
        rHi := aH.get(iHigh)
        rHiI := iHigh
        rLo := hL
        rLoI := n
        slBroken := true
        lastDnBrkI := n
        trend := -1
        evMsbDn := true
        f_obAt(iHigh, -1)
    else if dnMSS
        f_structLabel("MSS", rLo, aT.get(rLoI), false)
        rLo := hL
        rLoI := n
        slBroken := true
        lastDnBrkI := n
        trend := -1
        evMssDn := true
        f_obAt(rHiI, -1)

    // Wicks stretch the range without changing the trend
    if trend != 0
        if hH > rHi
            rHi := hH
            rHiI := n
        if hL < rLo
            rLo := hL
            rLoI := n

    // Fair value gaps
    if n >= 2 and not na(hAtr)
        float gUp = aL.get(n) - aH.get(n - 2)
        float gDn = aL.get(n - 2) - aH.get(n)
        if gUp > 0 and gUp >= fvgMinAtr * hAtr and aC.get(n - 1) > aO.get(n - 1)
            f_addPoi(aL.get(n), aH.get(n - 2), aT.get(n - 2), 1, "FVG")
        if gDn > 0 and gDn >= fvgMinAtr * hAtr and aC.get(n - 1) < aO.get(n - 1)
            f_addPoi(aL.get(n - 2), aH.get(n), aT.get(n - 2), -1, "FVG")

// ─────────────────────────────────────────────────────────────────────────────
// Chart time frame: POI tag, LTF flip, entry, stop, target
// ─────────────────────────────────────────────────────────────────────────────
float atr = ta.atr(14)
float rng = rHi - rLo
float eq  = (rHi + rLo) / 2
bool canLong  = trend == 1 and tradeDir != "Short only" and rng > 0
bool canShort = trend == -1 and tradeDir != "Long only" and rng > 0
bool useLtf   = entryMethod == ZOOM

var string lastLiq = ""
if trend != 0 and (high > rHi or low < rLo or evMsbUp or evMsbDn)
    lastLiq := "External"

// Position and pending order state
var int   posDir = 0
var float posE = na
var float posS = na
var float posT = na
var int   posBar = na
var line  lE = na
var line  lS = na
var line  lT = na
var int   nWin = 0
var int   nLoss = 0
var float netR = 0.0

var int   pendDir = 0
var float pendE = na
var float pendS = na
var float pendT = na
var int   pendBar = na

var int    armedDir = 0
var int    armedBar = na
var POI    armedPoi = na
var string tagTxt = "None"

var int   st = 0
var float swExt = na
var float refP = na
var int   refI = na
var int   swBar = na

bool longSig = false
bool shortSig = false
bool setupLong = false
bool setupShort = false
bool tagEvent = false
bool hitT = false
bool hitS = false

int   openDir = 0
float openE = na
float openS = na
float openT = na
bool  openLimit = false

// LTF swings
float ph = ta.pivothigh(high, ltfL, ltfL)
float pl = ta.pivotlow(low, ltfL, ltfL)
var float lphP = na
var int   lphI = na
var float lplP = na
var int   lplI = na
if not na(ph)
    lphP := ph
    lphI := bar_index - ltfL
if not na(pl)
    lplP := pl
    lplI := bar_index - ltfL

// 1) Breaker retest fill
if pendDir != 0 and posDir == 0 and bar_index > pendBar
    bool fill = pendDir == 1 ? low <= pendE : high >= pendE
    bool ran  = pendDir == 1 ? high >= pendT : low <= pendT
    if fill
        openDir := pendDir
        openE := pendDir == 1 ? math.min(open, pendE) : math.max(open, pendE)
        openS := pendS
        openT := pendT
        openLimit := true
        pendDir := 0
    else if ran or bar_index - pendBar > retestBars or pendDir != trend
        pendDir := 0

// 2) POI tag
if armedDir != 0 and (bar_index - armedBar > armBars or armedDir != trend)
    armedDir := 0
    st := 0

POI tagP = na
if (canLong or canShort) and pois.size() > 0
    for p in pois
        if canLong and p.dir == 1 and p.top <= rHi and p.top > rLo and (not poiNeedZone or p.bot < eq) and low <= p.top and high >= p.bot
            tagP := p
        if canShort and p.dir == -1 and p.bot >= rLo and p.bot < rHi and (not poiNeedZone or p.top > eq) and high >= p.bot and low <= p.top
            tagP := p

if not na(tagP) and posDir == 0 and pendDir == 0 and openDir == 0
    tagEvent := armedDir == 0 or bar_index - armedBar > 1
    if armedDir != tagP.dir
        st := 0
    armedDir := tagP.dir
    armedBar := bar_index
    armedPoi := tagP
    tagTxt := (tagP.dir == 1 ? "+" : "−") + tagP.kind
    lastLiq := "Internal"

    // HTF-only method: limit at the POI, stop past the range, target the other side
    if not useLtf and not tagP.used
        float e = tagP.dir == 1 ? math.min(open, tagP.top) : math.max(open, tagP.bot)
        float s = tagP.dir == 1 ? rLo - stopBuf * atr : rHi + stopBuf * atr
        float t = tagP.dir == 1 ? rHi : rLo
        float risk = math.abs(e - s)
        bool okSide = tagP.dir == 1 ? (t > e and e > s) : (t < e and e < s)
        if okSide and risk > 0 and math.abs(t - e) / risk >= minRR
            openDir := tagP.dir
            openE := e
            openS := s
            openT := t
            openLimit := true

// 3) LTF flip: low taken, then a close through the high (MSS). Enter on that close (or at the breaker).
if useLtf and armedDir != 0 and posDir == 0 and pendDir == 0 and openDir == 0
    if st == 0
        if armedDir == 1 and not na(lplP) and not na(lphP) and lphI > lplI and low < lplP
            st := 1
            swExt := low
            refP := lphP
            refI := lphI
            swBar := bar_index
        else if armedDir == -1 and not na(lplP) and not na(lphP) and lplI > lphI and high > lphP
            st := 1
            swExt := high
            refP := lplP
            refI := lplI
            swBar := bar_index
    else
        if armedDir == 1
            swExt := math.min(swExt, low)
            if lphI > swBar and lphP < refP
                refP := lphP
                refI := lphI
        else
            swExt := math.max(swExt, high)
            if lplI > swBar and lplP > refP
                refP := lplP
                refI := lplI

        bool mss = barstate.isconfirmed and (armedDir == 1 ? close > refP : close < refP)
        int off = bar_index - refI
        if mss and off <= 400
            // Breaker: the up candles before the drop (down candles before the pop for shorts)
            int k = off
            int tries = 0
            while tries < 5 and (armedDir == 1 ? close[k] <= open[k] : close[k] >= open[k])
                k += 1
                tries += 1
            float zt = high[k]
            float zb = low[k]
            int m = 1
            while m <= 2 and (armedDir == 1 ? close[k + m] > open[k + m] : close[k + m] < open[k + m])
                zt := math.max(zt, high[k + m])
                zb := math.min(zb, low[k + m])
                m += 1

            float lvl = armedDir == 1 ? zt : zb
            bool immediate = ltfEntry == MSSCLOSE or (armedDir == 1 ? close <= lvl : close >= lvl)
            float e = immediate ? close : lvl
            float s = armedDir == 1 ? swExt - stopBuf * atr : swExt + stopBuf * atr
            float t = armedDir == 1 ? rHi : rLo
            float risk = math.abs(e - s)
            bool okSide = armedDir == 1 ? (t > e and e > s) : (t < e and e < s)
            if okSide and risk > 0 and math.abs(t - e) / risk >= minRR
                setupLong := armedDir == 1
                setupShort := armedDir == -1
                if showTrades
                    box.new(bar_index - k - m + 1, zt, bar_index + (immediate ? 1 : retestBars), zb, bgcolor = color.new(colBrk, 82), border_color = color.new(colBrk, 30), text = "LTF breaker", text_size = size.tiny, text_color = color.new(colBrk, 10), text_halign = text.align_left, text_valign = text.align_bottom)
                if immediate
                    openDir := armedDir
                    openE := e
                    openS := s
                    openT := t
                else
                    pendDir := armedDir
                    pendE := e
                    pendS := s
                    pendT := t
                    pendBar := bar_index
            st := 0
            if pendDir == 0 and openDir == 0
                armedDir := 0

// 4) Open the trade
if openDir != 0 and posDir == 0
    posDir := openDir
    posE := openE
    posS := openS
    posT := openT
    posBar := bar_index
    float riskPer = math.abs(posE - posS)
    float rr = math.abs(posT - posE) / riskPer
    int qty = int(math.floor(riskUsd / riskPer))
    if showTrades
        lE := line.new(bar_index, posE, bar_index + 1, posE, color = #5aa9ff, width = 1)
        lS := line.new(bar_index, posS, bar_index + 1, posS, color = colBear, width = 1)
        lT := line.new(bar_index, posT, bar_index + 1, posT, color = colBull, width = 1)
        label.new(bar_index, posS, (posDir == 1 ? "LONG " : "SHORT ") + str.tostring(rr, "#.#") + "R\n" + str.tostring(qty) + " sh", style = posDir == 1 ? label.style_label_up : label.style_label_down, color = posDir == 1 ? colBull : colBear, textcolor = #070d17, size = size.small)
    longSig := posDir == 1
    shortSig := posDir == -1
    if not na(armedPoi)
        armedPoi.used := true
        f_style(armedPoi)
    armedDir := 0
    st := 0

// 5) Manage the trade. If stop and target sit in the same candle, the stop is counted.
if posDir != 0
    bool entryBar = bar_index == posBar
    bool sHit = (not entryBar or openLimit) and (posDir == 1 ? low <= posS : high >= posS)
    bool tHit = not entryBar and (posDir == 1 ? high >= posT : low <= posT)
    if showTrades and not na(lE)
        lE.set_x2(bar_index)
        lS.set_x2(bar_index)
        lT.set_x2(bar_index)
    if sHit or tHit
        float r = sHit ? -1.0 : math.abs(posT - posE) / math.abs(posE - posS)
        netR += r
        if sHit
            nLoss += 1
            hitS := true
        else
            nWin += 1
            hitT := true
        if showTrades
            label.new(bar_index, sHit ? posS : posT, sHit ? "−1R" : "+" + str.tostring(r, "#.#") + "R", style = label.style_none, textcolor = sHit ? colBear : colBull, size = size.small)
        // A stop-out takes the low (high for shorts) the trade sat on: that is a new "low taken",
        // so the LTF flip starts again from here (video: low taken, then a close through the high).
        if sHit and useLtf and trend == posDir
            armedDir := posDir
            armedBar := bar_index
            st := 1
            swExt := posDir == 1 ? low : high
            refP := posDir == 1 ? lphP : lplP
            refI := posDir == 1 ? lphI : lplI
            swBar := bar_index
        posDir := 0

// ─────────────────────────────────────────────────────────────────────────────
// Plots
// ─────────────────────────────────────────────────────────────────────────────
plot(showRange ? rHi : na, "Range high (external liquidity)", color = #e0505a, style = plot.style_steplinebr, linewidth = 1)
plot(showRange ? rLo : na, "Range low (external liquidity)", color = #2ecf7a, style = plot.style_steplinebr, linewidth = 1)
plot(showRange ? eq : na, "0.5 (premium above, discount below)", color = #9fb3c8, style = plot.style_steplinebr, linewidth = 1)

float oteA = trend == 1 ? rHi - rng * 0.618 : trend == -1 ? rLo + rng * 0.618 : na
float oteB = trend == 1 ? rHi - rng * 0.786 : trend == -1 ? rLo + rng * 0.786 : na
pA = plot(showOte ? oteA : na, "OTE 0.618", color = color.new(#f4b942, 65), style = plot.style_steplinebr)
pB = plot(showOte ? oteB : na, "OTE 0.786", color = color.new(#f4b942, 65), style = plot.style_steplinebr)
fill(pA, pB, color = color.new(#f4b942, 92), title = "OTE zone")

plotshape(longSig, "Long entry", shape.triangleup, location.belowbar, #2ecf7a, size = size.small)
plotshape(shortSig, "Short entry", shape.triangledown, location.abovebar, #e0505a, size = size.small)
plotshape(setupLong, "LTF MSS (long setup)", shape.circle, location.belowbar, #f4b942, size = size.tiny)
plotshape(setupShort, "LTF MSS (short setup)", shape.circle, location.abovebar, #f4b942, size = size.tiny)

// Data window readouts
plot(trend, "HTF trend (1 up, -1 down)", display = display.data_window)
plot(pois.size(), "Active POIs", display = display.data_window)
plot(armedDir, "At POI (1 long, -1 short)", display = display.data_window)
plot(nWin, "Targets hit", display = display.data_window)
plot(nLoss, "Stops hit", display = display.data_window)
plot(netR, "Net R", display = display.data_window)

// ─────────────────────────────────────────────────────────────────────────────
// Pre-trade checklist
// ─────────────────────────────────────────────────────────────────────────────
var table tb = na
if showTable and barstate.islast
    if na(tb)
        string posTxt = tablePos
        tb := table.new(posTxt == "Top right" ? position.top_right : posTxt == "Bottom right" ? position.bottom_right : posTxt == "Bottom left" ? position.bottom_left : position.top_left, 2, 8, bgcolor = #0c1626, border_color = #1b2a3e, border_width = 1, frame_color = #1b2a3e, frame_width = 1)

    string trendTxt = switch trend
        1  => "Uptrend"
        -1 => "Downtrend"
        => "None · wait"
    color trendCol = switch trend
        1  => #2ecf7a
        -1 => #e0505a
        => #f4b942
    string dirTxt = canLong ? "Long" : canShort ? "Short" : "No trade"
    float pct = rng > 0 ? (close - rLo) / rng * 100 : na
    string zoneTxt = na(pct) ? "—" : (pct > 50 ? "Premium " : "Discount ") + str.tostring(pct, "#") + "%"
    bool zoneOk = not na(pct) and ((trend == 1 and pct < 50) or (trend == -1 and pct > 50))
    string liqTxt = switch lastLiq
        "External" => "External · draw is internal"
        "Internal" => "Internal · draw is external"
        => "—"
    bool liqOk = lastLiq == "Internal"
    bool atPoi = armedDir != 0 or posDir != 0 or pendDir != 0
    string poiTxt = atPoi ? tagTxt + " tagged" : "None at price"
    string ltfTxt = switch
        not useLtf        => "Not used (HTF entry)"
        posDir != 0       => "Flipped · in trade"
        pendDir != 0      => "Flipped · limit at breaker"
        st == 1           => armedDir == 1 ? "Low taken · wait for MSS" : "High taken · wait for MSS"
        armedDir != 0     => "At POI · still against you"
        => "—"
    color ltfCol = switch
        not useLtf                    => #9fb3c8
        posDir != 0 or pendDir != 0   => #2ecf7a
        armedDir != 0                 => #f4b942
        => #6d84a0

    table.cell(tb, 0, 0, "ICT MADE SIMPLE", text_color = #e7eff8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 0, "HTF " + htf, text_color = #f4b942, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 1, "HTF trend", text_color = #9fb3c8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 1, trendTxt, text_color = trendCol, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 2, "Direction", text_color = #9fb3c8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 2, dirTxt, text_color = canLong ? #2ecf7a : canShort ? #e0505a : #f4b942, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 3, "Price in range", text_color = #9fb3c8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 3, zoneTxt, text_color = zoneOk ? #2ecf7a : #f4b942, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 4, "Liquidity taken", text_color = #9fb3c8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 4, liqTxt, text_color = liqOk ? #2ecf7a : #f4b942, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 5, "POI", text_color = #9fb3c8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 5, poiTxt, text_color = atPoi ? #2ecf7a : #6d84a0, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 6, "LTF", text_color = #9fb3c8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 6, ltfTxt, text_color = ltfCol, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 7, "Signals on chart", text_color = #9fb3c8, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 7, str.tostring(nWin) + " target · " + str.tostring(nLoss) + " stop · " + (netR >= 0 ? "+" : "") + str.tostring(netR, "#.#") + "R", text_color = netR >= 0 ? #2ecf7a : #e0505a, text_size = size.small, text_halign = text.align_right)

// ─────────────────────────────────────────────────────────────────────────────
// Alerts
// ─────────────────────────────────────────────────────────────────────────────
f_json(string ev, string side, float e, float s, float t) =>
    '{"indicator":"ICT Made Simple","event":"' + ev + '","side":"' + side + '","ticker":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","htf":"' + htf + '","price":' + str.tostring(close, format.mintick) + ',"entry":' + str.tostring(nz(e, close), format.mintick) + ',"stop":' + str.tostring(nz(s), format.mintick) + ',"target":' + str.tostring(nz(t), format.mintick) + ',"time":"' + str.tostring(time) + '"}'

bool conf = barstate.isconfirmed
bool structUp = evMsbUp or evMssUp
bool structDn = evMsbDn or evMssDn

if conf
    if alEntry and longSig
        alert(f_json("entry", "long", posE, posS, posT), alert.freq_once_per_bar_close)
    if alEntry and shortSig
        alert(f_json("entry", "short", posE, posS, posT), alert.freq_once_per_bar_close)
    if alSetup and setupLong
        alert(f_json("ltf_mss", "long", pendE, pendS, pendT), alert.freq_once_per_bar_close)
    if alSetup and setupShort
        alert(f_json("ltf_mss", "short", pendE, pendS, pendT), alert.freq_once_per_bar_close)
    if alTag and tagEvent
        alert(f_json("poi_tagged", armedDir == 1 ? "long" : "short", na, na, na), alert.freq_once_per_bar_close)
    if alStruct and (structUp or structDn)
        alert(f_json(evMsbUp or evMsbDn ? "htf_msb" : "htf_mss", structUp ? "long" : "short", na, na, na), alert.freq_once_per_bar_close)
    if alExit and hitT
        alert(f_json("target_hit", "flat", na, na, na), alert.freq_once_per_bar_close)
    if alExit and hitS
        alert(f_json("stop_hit", "flat", na, na, na), alert.freq_once_per_bar_close)

alertcondition(conf and longSig, "ICT Simple — Long entry", "ICT Made Simple LONG on {{ticker}} @ {{close}}")
alertcondition(conf and shortSig, "ICT Simple — Short entry", "ICT Made Simple SHORT on {{ticker}} @ {{close}}")
alertcondition(conf and setupLong, "ICT Simple — LTF MSS (long setup)", "LTF MSS up at a bullish POI on {{ticker}} @ {{close}}")
alertcondition(conf and setupShort, "ICT Simple — LTF MSS (short setup)", "LTF MSS down at a bearish POI on {{ticker}} @ {{close}}")
alertcondition(conf and tagEvent, "ICT Simple — POI tagged", "Price reached an HTF POI on {{ticker}} @ {{close}}")
alertcondition(conf and structUp, "ICT Simple — HTF bullish MSB / MSS", "HTF bullish structure break on {{ticker}} @ {{close}}")
alertcondition(conf and structDn, "ICT Simple — HTF bearish MSB / MSS", "HTF bearish structure break on {{ticker}} @ {{close}}")
alertcondition(conf and hitT, "ICT Simple — Target hit", "Target (external liquidity) hit on {{ticker}} @ {{close}}")
alertcondition(conf and hitS, "ICT Simple — Stop hit", "Stop hit on {{ticker}} @ {{close}}")
