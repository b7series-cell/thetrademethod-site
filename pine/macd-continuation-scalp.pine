//@version=6
// =====================================================================
// MACD Continuation Scalp — thetrademethod.com
//
// The SMB video's base-hit scalp (Jeff Holden and Garrett Drinon), for
// 1-minute charts:
//
//   1. Flat        The MACD line (3/9/5) wrapped around zero for 3 to
//                  15 bars: the averages converge, energy builds.
//   2. Expansion   The MACD leaves that band, away from its signal.
//   3. The dip     The MACD crosses under its signal (over, for a
//                  short) while both lines stay on their side of zero.
//                  If either line crosses zero, there's no trade.
//   4. Entry       The cross back, both lines still past zero.
//   5. Stop        Just past the dip's low (high).
//   6. Exit        The MACD crosses back against the trade, or the stop.
//                  One trade per setup: then wait for a new flat.
//
// The pane shows the MACD, its signal and the flat band. Entries, stops
// and exits are drawn on the price chart. No histogram, as in the video.
// How flat counts as "wrapped around zero" (a band in ATR) is ours: the
// video judges it by eye. It marks and alerts. It does not place trades.
// =====================================================================
indicator("MACD Continuation Scalp [TTM]", shorttitle = "MACD CS", overlay = false, max_labels_count = 300, max_lines_count = 300)

grpM = "MACD"
fastN  = input.int(3, "Fast", minval = 1, group = grpM)
slowN  = input.int(9, "Slow", minval = 2, group = grpM)
sigN   = input.int(5, "Signal", minval = 1, group = grpM)

grpS = "Setup"
bandX  = input.float(0.15, "Flat band (x ATR 14)", minval = 0.01, step = 0.01, group = grpS, tooltip = "Ours: the MACD line counts as wrapped around zero while it stays within this many ATRs of zero. The video judges it by eye.")
minC   = input.int(3, "Flat for at least (bars)", minval = 1, group = grpS, tooltip = "The video: 3 minutes.")
maxC   = input.int(15, "Flat for at most (bars)", minval = 1, group = grpS, tooltip = "The video: up to about 15 minutes.")
waitN  = input.int(30, "Expansion and dip within (bars)", minval = 2, group = grpS, tooltip = "Ours: how long the setup stays armed.")
sideIn = input.string("Both", "Side", options = ["Long", "Short", "Both"], group = grpS, tooltip = "The video's examples are long; the short is the mirror below zero.")
stopTk = input.int(1, "Stop past the dip (ticks)", minval = 0, group = grpS)
sessIn = input.session("0930-1600", "Regular hours (New York)", group = grpS, tooltip = "Setups only inside these hours; an open trade is closed at the end.")

grpV = "Display"
showTbl = input.bool(true, "Panel", group = grpV)

// ---------------------------------------------------------------- MACD
m = ta.ema(close, fastN) - ta.ema(close, slowN)
s = ta.ema(m, sigN)
band = bandX * ta.atr(14)
inBand = math.abs(m) <= band
var int run = 0
run := inBand ? run + 1 : 0

inSess = not na(time(timeframe.period, sessIn, "America/New_York"))

// ---------------------------------------------------------------- state
// 0 idle, 1 waiting for the expansion, 2 expanded (waiting for the dip), 3 in the dip, 4 in a trade
var int st = 0
var int side = 0
var int dl = na
var float ext = na
var float tEntry = na
var float tStop = na
var float tRisk = na
var int nTrades = 0
var int nWins = 0
var float sumR = 0.0
var line lStop = na

bool sigLong = false
bool sigShort = false
bool sigExit = false
float exitR = na

allowL = sideIn != "Short"
allowS = sideIn != "Long"

// manage an open trade first
if st == 4
    bool hit = side == 1 ? low <= tStop : high >= tStop
    bool crossAgainst = side == 1 ? m < s : m > s
    bool sessOver = not inSess
    if hit or crossAgainst or sessOver
        float px = hit ? tStop : close
        exitR := (px - tEntry) * side / tRisk
        nTrades += 1
        sumR += exitR
        if exitR > 0
            nWins += 1
        sigExit := true
        st := 0
        side := 0
    else if not na(lStop)
        lStop.set_x2(bar_index)

// the setup
if st == 1
    if inBand or bar_index > dl or not inSess
        st := 0
    else if m > band and m > s and allowL
        side := 1
        st := 2
    else if m < -band and m < s and allowS
        side := -1
        st := 2
else if st == 2 or st == 3
    if side * m <= 0 or side * s <= 0 or bar_index > dl or not inSess
        st := 0
        side := 0
    else if st == 2
        if side * (m - s) < 0
            st := 3
            ext := side == 1 ? low : high
    else
        ext := side == 1 ? math.min(ext, low) : math.max(ext, high)
        if side * (m - s) > 0
            tEntry := close
            tStop := ext - side * stopTk * syminfo.mintick
            tRisk := math.abs(tEntry - tStop)
            if tRisk > 0
                st := 4
                sigLong := side == 1
                sigShort := side == -1
                lStop := line.new(bar_index, tStop, bar_index + 1, tStop, color = color.rgb(255, 69, 58), style = line.style_dashed, width = 2, force_overlay = true)
            else
                st := 0
                side := 0

// a flat run just ended: arm the setup
if st == 0 and inSess and not inBand and inBand[1] and run[1] >= minC and run[1] <= maxC
    dl := bar_index + waitN
    st := 1
    if m > band and m > s and allowL
        side := 1
        st := 2
    else if m < -band and m < s and allowS
        side := -1
        st := 2

// ---------------------------------------------------------------- drawing
hline(0, "Zero", color.new(color.gray, 40))
pBandU = plot(band, "Flat band", color.new(color.gray, 70))
pBandD = plot(-band, "Flat band (low)", color.new(color.gray, 70))
fill(pBandU, pBandD, color.new(color.gray, 92), "Flat band")
plot(m, "MACD 3/9", color.rgb(229, 229, 234), 2)
plot(s, "Signal 5", color.rgb(255, 69, 58), 1)
bgcolor(inBand and run >= minC and run <= maxC ? color.new(color.rgb(48, 209, 88), 90) : na, title = "Flat run")

plotshape(sigLong, "Long: cross back above zero", shape.triangleup, location.belowbar, color.rgb(48, 209, 88), size = size.small, text = "MACD", force_overlay = true)
plotshape(sigShort, "Short: cross back below zero", shape.triangledown, location.abovebar, color.rgb(255, 69, 58), size = size.small, text = "MACD", force_overlay = true)
plotshape(sigExit, "Exit", shape.xcross, location.abovebar, color.rgb(255, 214, 10), size = size.tiny, force_overlay = true)

alertcondition(sigLong, "MACD continuation: long", "MACD crossed back over its signal above zero after a flat and an expansion. Long.")
alertcondition(sigShort, "MACD continuation: short", "MACD crossed back under its signal below zero after a flat and an expansion. Short.")
alertcondition(sigExit, "MACD continuation: exit", "MACD crossed back against the trade, or the stop was hit.")
if sigLong or sigShort
    alert((sigLong ? "MACD continuation long" : "MACD continuation short") + " on " + syminfo.ticker + ". Entry " + str.tostring(tEntry, format.mintick) + ", stop " + str.tostring(tStop, format.mintick) + ".", alert.freq_once_per_bar_close)

var table tb = table.new(position.top_right, 2, 4, bgcolor = color.new(#1d1d1f, 8), frame_color = color.new(#3a3a3c, 0), frame_width = 1)
if showTbl and barstate.islast
    string state = st == 4 ? (side == 1 ? "In a long" : "In a short") : st == 3 ? "Dip · waiting for the cross back" : st == 2 ? "Expanded · waiting for the dip" : st == 1 ? "Flat ended · watching" : inBand ? "Flat · " + str.tostring(run) + " bars" : "Waiting for a flat"
    table.cell(tb, 0, 0, "MACD Continuation", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 0, state, text_color = color.rgb(209, 209, 214), text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 1, "Trades · wins", text_color = color.rgb(209, 209, 214), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 1, str.tostring(nTrades) + " · " + str.tostring(nWins), text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 2, "Average R", text_color = color.rgb(209, 209, 214), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 2, nTrades > 0 ? str.tostring(sumR / nTrades, "#.##") : "-", text_color = color.white, text_size = size.small, text_halign = text.align_right)
    table.cell(tb, 0, 3, "Costs", text_color = color.rgb(209, 209, 214), text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, 3, "not included", text_color = color.white, text_size = size.small, text_halign = text.align_right)
